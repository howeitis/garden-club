---
import BaseLayout from '../layouts/BaseLayout.astro';
import Flourish from '../components/Flourish.astro';
import SmartImage from '../components/SmartImage.astro';
import { club } from '../data/index';
import Button from '../components/Button.astro';
---

<BaseLayout
  title={`Page Not Found | ${club.name}`}
  description="The page you're looking for doesn't exist."
>
  <div class="flex flex-col items-center justify-center min-h-[60vh] px-4 pt-40 pb-24 text-center">
    <SmartImage
      src="/gggc-clean.png"
      alt={club.name}
      widths={[126, 252, 378]}
      sizes="126px"
      class="h-28 w-auto object-contain mb-8"
      loading="eager"
    />
    <h1 class="font-heading text-5xl sm:text-6xl font-semibold text-primary mb-5">
      Still digging.
    </h1>
    <Flourish class="mb-6" />
    <p class="text-text/70 text-lg mb-10 max-w-md leading-relaxed">
      We couldn't find that page. It may have moved, or perhaps it was never planted here to begin with.
    </p>
    <Button href="/">Back to Home</Button>
  </div>
</BaseLayout>
