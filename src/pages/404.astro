---
import BaseLayout from '../layouts/BaseLayout.astro';
import { clubInfo } from '../data/index';
---

<BaseLayout
  title={`Page Not Found | ${clubInfo.name}`}
  description="The page you're looking for doesn't exist."
>
  <div class="flex flex-col items-center justify-center min-h-[60vh] px-4 py-20 text-center">
    <img
      src="/gggc-hero.png"
      alt={clubInfo.name}
      class="h-24 w-auto object-contain mb-8 opacity-80"
      loading="eager"
    />
    <h1 class="font-heading text-5xl sm:text-6xl font-bold text-primary mb-4">
      Still digging.
    </h1>
    <p class="text-text/60 text-lg mb-10 max-w-md leading-relaxed">
      We couldn't find that page. It may have moved, or perhaps it was never planted here to begin with.
    </p>
    <a
      href="/"
      class="bg-primary text-background font-semibold px-7 py-3 rounded-lg hover:bg-primary/90 transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2"
    >
      Back to Home
    </a>
  </div>
</BaseLayout>
