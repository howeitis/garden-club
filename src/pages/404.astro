---
import BaseLayout from '../layouts/BaseLayout.astro';
import Flourish from '../components/Flourish.astro';
import { clubInfo } from '../data/index';
---

<BaseLayout
  title={`Page Not Found | ${clubInfo.name}`}
  description="The page you're looking for doesn't exist."
>
  <div class="flex flex-col items-center justify-center min-h-[60vh] px-4 pt-40 pb-24 text-center">
    <img
      src="/gggc-clean.png"
      alt={clubInfo.name}
      class="h-28 w-auto object-contain mb-8"
      loading="eager"
    />
    <h1 class="font-heading text-5xl sm:text-6xl font-semibold text-primary mb-5">
      Still digging.
    </h1>
    <Flourish class="mb-6" />
    <p class="text-text/70 text-lg mb-10 max-w-md leading-relaxed">
      We couldn't find that page. It may have moved, or perhaps it was never planted here to begin with.
    </p>
    <a
      href="/"
      class="bg-primary text-background text-[0.8rem] font-semibold uppercase tracking-[0.18em] px-9 py-4 rounded-sm hover:bg-[#1f4128] transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-gold focus:ring-offset-2"
    >
      Back to Home
    </a>
  </div>
</BaseLayout>
