---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import LandingCard from '../components/LandingCard.astro';
import { clubInfo } from '../data/index';

const greenGlow = 'shadow-[0_0_14px_rgba(123,158,107,0.4)]';
const redGlow = 'shadow-[0_0_14px_rgba(196,30,58,0.4)]';
---

<BaseLayout
  title={`Resources | ${clubInfo.name}`}
  description={`Gardening tips, plant guides, and gardens to visit — curated by ${clubInfo.name}.`}
>
  <PageHero
    eyebrow="For Gardeners"
    title="Resources"
    subtitle="Tips, inspiration, and places to explore for gardeners of every level."
  />

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-20">

    <LandingCard
      href="/resources/gardening-tips"
      tone="blossom"
      eyebrow="🌷 Grow Better"
      title="Gardening Tips"
      description="Evergreen fundamentals plus our Garden Rhythms — the recurring weekly and monthly tasks that keep a healthy garden humming all season long."
      cta="Visit the Tips Guide"
      images={[
        { src: '/soil.jpg' },
        { src: '/water.jpg' },
        { src: '/pests.webp' },
        { src: '/compost.webp' },
      ]}
    />

    <LandingCard
      href="/resources/plants"
      tone="accent"
      eyebrow="🌿 Plant Guide"
      title="Native &amp; Banned Plants of Delaware"
      description="Explore the natives that thrive in our Piedmont region — and the invasive species that should be avoided to protect our local ecosystems."
      cta="Visit the Plant Guide"
      images={[
        { src: '/americanholly.webp', glow: greenGlow },
        { src: '/butterflyweed.webp', glow: greenGlow },
        { src: '/englishivy.webp',    glow: redGlow   },
        { src: '/oriental-bittersweet.webp', glow: redGlow },
      ]}
    />

    <LandingCard
      href="/resources/gardens"
      tone="marigold"
      eyebrow="🌻 Garden Guide"
      title="Gardens to Visit"
      description="From local treasures in the Brandywine Valley to renowned regional destinations just beyond, discover public gardens worth a visit any season of the year."
      cta="Visit the Garden Guide"
      images={[
        { src: '/longwoodvisit.webp' },
        { src: '/mtcuba.webp' },
        { src: '/chanticleer.webp' },
        { src: '/morris.webp' },
      ]}
    />

  </div>
</BaseLayout>
