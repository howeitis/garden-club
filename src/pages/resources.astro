---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import LandingCard from '../components/LandingCard.astro';
import { club, getPageCopy } from '../data/index';

const copy = await getPageCopy('resources');
---

<BaseLayout
  title={`Gardening Resources for Delaware Gardeners | ${club.name}`}
  description={`Gardening tips for Zone 7a, native and invasive plants of Delaware, and public gardens to visit near Wilmington — curated by ${club.name}.`}
>
  <PageHero
    eyebrow="For Gardeners"
    title="Resources"
    subtitle={copy.heroSubtitle}
    accent="gold"
  />

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20 divide-y divide-gold/20">

    <LandingCard
      href="/resources/gardening-tips"
      eyebrow="Grow Better"
      eyebrowColor="text-marigold"
      title="Gardening Tips"
      description={copy.tipsDescription}
      cta="Visit the Tips Guide"
      images={[
        { src: '/soil.jpg' },
        { src: '/water.jpg' },
        { src: '/pests.webp' },
        { src: '/compost.webp' },
      ]}
    />

    <LandingCard
      href="/resources/plants"
      flip
      eyebrow="Plant Guide"
      eyebrowColor="text-blossom-deep"
      title="Native &amp; Banned Plants of Delaware"
      description={copy.plantsDescription}
      cta="Visit the Plant Guide"
      images={[
        { src: '/americanholly.webp' },
        { src: '/butterflyweed.webp' },
        { src: '/englishivy.webp' },
        { src: '/oriental-bittersweet.webp' },
      ]}
    />

    <LandingCard
      href="/resources/gardens"
      eyebrow="Garden Guide"
      eyebrowColor="text-primary"
      title="Gardens to Visit"
      description={copy.gardensDescription}
      cta="Visit the Garden Guide"
      images={[
        { src: '/longwoodvisit.webp' },
        { src: '/mtcuba.webp' },
        { src: '/chanticleer.webp' },
        { src: '/morris.webp' },
      ]}
    />

  </div>
</BaseLayout>
