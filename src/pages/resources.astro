---
import BaseLayout from '../layouts/BaseLayout.astro';
import { clubInfo } from '../data/index';

const gardeningTips = [
  {
    title: 'Start with Your Soil',
    description:
      'Healthy soil is the foundation of every great garden. Test your soil pH and amend with compost before planting. Most garden plants thrive in slightly acidic to neutral soil (pH 6.0–7.0).',
    image: '/flower.jpg',
  },
  {
    title: 'Water Wisely',
    description:
      'Water deeply and less frequently to encourage deep root growth. Early morning is the best time to water — it reduces evaporation and helps prevent fungal diseases.',
    image: '/bird.jpg',
  },
  {
    title: 'Right Plant, Right Place',
    description:
      'Choose plants that match your site conditions — sun exposure, soil type, and hardiness zone. In Delaware (Zone 7a), you can grow a wide range of perennials, shrubs, and trees.',
    image: '/rightplace.jpg',
  },
  {
    title: 'Mulch Matters',
    description:
      'Apply 2–3 inches of organic mulch around plants to conserve moisture, suppress weeds, and regulate soil temperature. Keep mulch a few inches away from stems and trunks.',
    image: '/club.jpg',
  },
  {
    title: 'Feed Your Garden',
    description:
      'Use a balanced fertilizer in spring and supplement with compost throughout the season. Native plants generally need less fertilizer than hybrid varieties.',
    image: '/club-2.jpg',
  },
  {
    title: 'Plan for Pollinators',
    description:
      'Include a variety of flower shapes and bloom times to support bees, butterflies, and hummingbirds from early spring through fall. Native wildflowers are especially beneficial.',
    image: '/pollinators.jpg',
  },
];

const localGardens = [
  {
    name: 'Longwood Gardens',
    location: 'Kennett Square, PA',
    description:
      'One of the world\'s premier horticultural display gardens, Longwood spans over 1,000 acres and features spectacular fountains, a conservatory with 4,600 plant species, extensive outdoor gardens, and a renowned meadow garden. The gardens offer year-round programming, seasonal displays, and breathtaking illuminated fountain performances.',
    website: 'longwoodgardens.org',
    image: '/longwoodvisit.webp',
  },
  {
    name: 'Winterthur Museum, Garden & Library',
    location: 'Winterthur, DE',
    description:
      'Set on nearly 1,000 acres in the Brandywine Valley, Winterthur\'s naturalistic garden is one of the finest in North America. Designed by Henry Francis du Pont, the garden features sweeping vistas, a stunning March Bank of early spring bulbs, native azaleas, and a renowned collection of rare and unusual plants arranged to look as though nature placed them.',
    website: 'winterthur.org',
    image: '/winterthur.jpg',
  },
  {
    name: 'Mt. Cuba Center',
    location: 'Hockessin, DE',
    description:
      'Dedicated to the study and conservation of native plants of the Appalachian Piedmont, Mt. Cuba Center features beautifully curated gardens and natural lands spanning over 1,000 acres. The gardens showcase the beauty of native wildflowers, ferns, and trees, and the center conducts important plant trials to help gardeners choose the best native cultivars.',
    website: 'mtcubacenter.org',
    image: '/mtcuba.webp',
  },
];
---

<BaseLayout
  title={`Resources | ${clubInfo.name}`}
  description={`Gardening tips, resources, and local gardens to visit — curated by ${clubInfo.name}.`}
>

  <!-- Page Header -->
  <section class="relative bg-primary text-background py-16 sm:py-24 overflow-hidden">
    <div class="absolute inset-0">
      <img src="/flower.jpg" alt="" class="w-full h-full object-cover opacity-40 mix-blend-overlay" loading="eager" />
      <div class="absolute inset-0 bg-primary/40" aria-hidden="true"></div>
    </div>
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-blossom text-xs font-semibold uppercase tracking-widest mb-3">For Gardeners</p>
      <h1 class="font-heading text-4xl sm:text-5xl font-bold leading-tight">Resources</h1>
      <p class="mt-4 text-background/75 text-lg max-w-xl mx-auto">
        Tips, inspiration, and places to explore for gardeners of every level.
      </p>
    </div>
  </section>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-20">

    <!-- Gardening Tips -->
    <section aria-labelledby="tips-heading">
      <h2 id="tips-heading" class="font-heading text-3xl font-bold text-text mb-4">
        Gardening Tips
      </h2>
      <p class="text-text/65 mb-10 text-sm leading-relaxed max-w-2xl">
        Whether you're a seasoned gardener or just getting started, these fundamentals will help
        your garden thrive.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {gardeningTips.map((tip) => (
          <div class="bg-white rounded-xl border border-accent/20 shadow-sm overflow-hidden hover:shadow-md transition-shadow duration-200">
            <img
              src={tip.image}
              alt={tip.title}
              class="w-full h-40 object-cover"
              loading="lazy"
            />
            <div class="p-5">
              <h3 class="font-heading text-lg font-semibold text-text mb-2">{tip.title}</h3>
              <p class="text-sm text-text/70 leading-relaxed">{tip.description}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Local Gardens to Visit -->
    <section aria-labelledby="gardens-heading">
      <h2 id="gardens-heading" class="font-heading text-3xl font-bold text-text mb-4">
        Local Gardens to Visit
      </h2>
      <p class="text-text/65 mb-10 text-sm leading-relaxed max-w-2xl">
        The Delaware and Brandywine Valley region is home to some of the most beautiful public
        gardens in the country. We encourage our members and visitors to explore these treasures.
      </p>

      <div class="space-y-8">
        {localGardens.map((garden) => (
          <div class="bg-white rounded-xl border border-accent/20 shadow-sm overflow-hidden hover:shadow-md transition-shadow duration-200">
            <div class="flex flex-col md:flex-row">
              <!-- Garden photo -->
              <div class="md:w-72 lg:w-80 flex-shrink-0">
                <img
                  src={garden.image}
                  alt={garden.name}
                  class="w-full h-56 md:h-full object-cover"
                  loading="lazy"
                />
              </div>
              <!-- Content -->
              <div class="p-6 flex-1">
                <div class="flex items-start justify-between gap-4 mb-2">
                  <h3 class="font-heading text-xl font-semibold text-text">{garden.name}</h3>
                </div>
                <p class="text-xs font-medium text-primary mb-3 flex items-center gap-1">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                  </svg>
                  {garden.location}
                </p>
                <p class="text-sm text-text/70 leading-relaxed mb-4">{garden.description}</p>
                <a
                  href={`https://${garden.website}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 text-sm font-medium text-primary hover:underline"
                >
                  {garden.website}
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                  </svg>
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

  </div>
</BaseLayout>
