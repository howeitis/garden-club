---
import BaseLayout from '../layouts/BaseLayout.astro';
import { clubInfo } from '../data/index';
---

<BaseLayout
  title={`Message Sent | ${clubInfo.name}`}
  description="Thank you for reaching out. We received your message and will be in touch soon."
>

  <section class="flex-1 flex items-center justify-center min-h-[70vh] px-4 sm:px-6 lg:px-8">
    <div class="max-w-lg mx-auto text-center pt-36 pb-20">

      <!-- Success icon -->
      <div
        class="w-20 h-20 rounded-full bg-gradient-to-br from-blossom/30 to-holly-light border border-blossom/30 flex items-center justify-center mx-auto mb-8"
        aria-hidden="true"
      >
        <svg class="w-10 h-10 text-holly" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
      </div>

      <h1 class="font-heading text-4xl sm:text-5xl font-bold text-text mb-4 leading-tight">
        Message Sent!
      </h1>

      <p class="text-text/70 text-lg leading-relaxed mb-3">
        Thank you for reaching out to <strong class="text-text">{clubInfo.name}</strong>.
      </p>
      <p class="text-text/60 text-base leading-relaxed mb-10">
        We've received your message and will get back to you as soon as possible — usually within a few days.
        We look forward to connecting with you.
      </p>

      <a
        href="/"
        class="inline-flex items-center gap-2 bg-holly text-background font-semibold px-8 py-3 rounded-lg
               hover:bg-holly/90 transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-holly focus:ring-offset-2"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Back to Home
      </a>

    </div>
  </section>

</BaseLayout>
