---
import BaseLayout from '../layouts/BaseLayout.astro';
import Flourish from '../components/Flourish.astro';
import { club } from '../data/index';
import Button from '../components/Button.astro';
---

<BaseLayout
  title={`Message Sent | ${club.name}`}
  description="Thank you for reaching out. We received your message and will be in touch soon."
  noindex
>

  <section class="flex-1 flex items-center justify-center min-h-[70vh] px-4 sm:px-6 lg:px-8">
    <div class="max-w-lg mx-auto text-center pt-40 pb-24">

      <!-- Success icon -->
      <div
        class="w-20 h-20 rounded-full border border-gold/40 flex items-center justify-center mx-auto mb-8"
        aria-hidden="true"
      >
        <svg class="w-9 h-9 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 13l4 4L19 7" />
        </svg>
      </div>

      <h1 class="font-heading text-5xl sm:text-6xl font-semibold text-text mb-5 leading-tight">
        Message Sent
      </h1>
      <Flourish class="mb-7" />

      <p class="text-text/75 text-lg leading-relaxed mb-3">
        Thank you for reaching out to <strong class="text-text font-semibold">{club.name}</strong>.
      </p>
      <p class="text-text/70 leading-relaxed mb-10">
        We've received your message and will get back to you as soon as possible — usually within a few days.
        We look forward to connecting with you.
      </p>

      <Button href="/" arrow="back">Back to Home</Button>

    </div>
  </section>

</BaseLayout>
