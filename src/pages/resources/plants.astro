---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import PlantCard from '../../components/PlantCard.astro';
import { club, plants, getPageCopy } from '../../data/index';

const copy = await getPageCopy('plants');
const nativePlants = plants.filter((p) => p.data.type === 'native');
const bannedPlants = plants.filter((p) => p.data.type === 'invasive');

---

<BaseLayout
  title={`Native & Invasive Plants of Delaware | ${club.name}`}
  description={`${nativePlants.length} Delaware natives worth planting and ${bannedPlants.length} invasive species to avoid, with bloom times and why each matters to the Piedmont ecosystem.`}
>
  <PageHero
    eyebrow="Delaware Flora"
    title="Plants"
    subtitle={copy.heroSubtitle}
    accent="sage"
  />

  <Breadcrumb items={[{ label: 'Resources', href: '/resources/' }, { label: 'Plants' }]} />

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-20">

    <section aria-labelledby="native-heading" class="fade-in-section">
      <SectionHeader label="Piedmont Flora" number="01" />
      <h2 id="native-heading" class="font-heading text-4xl sm:text-5xl font-semibold tracking-[-0.01em] text-text mb-5">
        Native Plants of Delaware
      </h2>
      <p class="text-text/75 mb-12 leading-relaxed max-w-2xl">{copy.nativesIntro}</p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-16">
        {nativePlants.map((plant) => (
          <PlantCard plant={plant} />
        ))}
      </div>
    </section>

    <section aria-labelledby="banned-heading" class="fade-in-section">
      <SectionHeader label="Avoid Planting" number="02" />
      <h2 id="banned-heading" class="font-heading text-4xl sm:text-5xl font-semibold tracking-[-0.01em] text-text mb-5">
        Delaware Banned &amp; Invasive Plants
      </h2>
      <p class="text-text/75 mb-12 leading-relaxed max-w-2xl">{copy.invasivesIntro}</p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-16">
        {bannedPlants.map((plant) => (
          <PlantCard plant={plant} />
        ))}
      </div>
    </section>

  </div>
</BaseLayout>
