---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import PlantCard from '../../components/PlantCard.astro';
import { clubInfo, plants } from '../../data/index';

const { native: nativePlants, banned: bannedPlants } = plants;
---

<BaseLayout
  title={`Plants | ${clubInfo.name}`}
  description={`Native and invasive plants of Delaware — a guide from ${clubInfo.name}.`}
>
  <PageHero
    eyebrow="Delaware Flora"
    title="Plants"
    subtitle="Natives to celebrate and invasives to avoid in the Delaware Piedmont."
    image="/butterflyweed.webp"
  />

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-20">

    <section aria-labelledby="native-heading" class="fade-in-section">
      <SectionHeader label="Piedmont Flora" tone="accent" icon="leaf" />
      <h2 id="native-heading" class="font-heading text-3xl font-bold text-text mb-4">
        Native Plants of Delaware
      </h2>
      <p class="text-text/65 mb-10 text-sm leading-relaxed max-w-2xl">
        The Appalachian Piedmont region of northern Delaware supports a rich diversity of native
        wildflowers, trees, and shrubs. These species are adapted to our soils and climate, require
        less maintenance, and provide essential habitat for local pollinators and wildlife.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {nativePlants.map((plant) => (
          <PlantCard {...plant} variant="native" />
        ))}
      </div>
    </section>

    <section aria-labelledby="banned-heading" class="fade-in-section">
      <SectionHeader label="Avoid Planting" tone="holly" />
      <h2 id="banned-heading" class="font-heading text-3xl font-bold text-text mb-4">
        Delaware Banned &amp; Invasive Plants
      </h2>
      <p class="text-text/65 mb-10 text-sm leading-relaxed max-w-2xl">
        These non-native species are restricted or discouraged in Delaware because they aggressively
        displace native vegetation, damage forests, and disrupt habitat for wildlife. Please remove
        them where possible and choose native alternatives instead.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {bannedPlants.map((plant) => (
          <PlantCard {...plant} variant="banned" />
        ))}
      </div>
    </section>

  </div>
</BaseLayout>
