---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import SmartImage from '../../components/SmartImage.astro';
import Prose from '../../components/Prose.astro';
import { render } from 'astro:content';
import { club, gardeningTips, getPageCopy } from '../../data/index';
import { inline } from '../../lib/markdown';

const copy = await getPageCopy('gardening-tips');
const withContent = async (tips: typeof gardeningTips) =>
  Promise.all(tips.map(async (tip) => ({ ...tip, Content: (await render(tip)).Content })));
const evergreenTips = await withContent(gardeningTips.filter((t) => t.data.section === 'fundamentals'));
const gardenRhythms = await withContent(gardeningTips.filter((t) => t.data.section === 'rhythms'));

---

<BaseLayout
  title={`Gardening Tips for Delaware (Zone 7a) | ${club.name}`}
  description={`Soil, watering, mulch, pollinators, and a weekly-to-monthly garden rhythm — practical tips for Delaware Piedmont gardens from ${club.name}.`}
>

  <PageHero
    eyebrow="Grow Better"
    title="Gardening Tips"
    subtitle={copy.heroSubtitle}
    accent="marigold"
  />

  <Breadcrumb items={[{ label: 'Resources', href: '/resources' }, { label: 'Gardening Tips' }]} />

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-20">

    <!-- Evergreen Tips -->
    <section aria-labelledby="evergreen-heading" class="fade-in-section">
      <SectionHeader label="Always True" number="01" />
      <h2 id="evergreen-heading" class="font-heading text-4xl sm:text-5xl font-semibold tracking-[-0.01em] text-text mb-5">
        Evergreen Tips
      </h2>
      <p class="text-text/75 mb-12 leading-relaxed max-w-2xl" set:html={inline(copy.fundamentalsIntro)} />

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-10 gap-y-14">
        {evergreenTips.map(({ data: tip, Content }) => (
          <div class="group">
            <div class="overflow-hidden rounded-sm mb-6">
              <SmartImage
                src={tip.image}
                alt={tip.title}
                widths={[400, 800, 1200]}
                sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                class="w-full h-60 sm:h-64 object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
              />
            </div>
            <h3 class="font-heading text-2xl font-semibold text-text mb-2.5">{tip.title}</h3>
            <Prose class="text-base text-text/75"><Content /></Prose>
          </div>
        ))}
      </div>
    </section>

    <!-- Garden Rhythms -->
    <section aria-labelledby="rhythms-heading" class="fade-in-section">
      <SectionHeader label="In Season" number="02" />
      <h2 id="rhythms-heading" class="font-heading text-4xl sm:text-5xl font-semibold tracking-[-0.01em] text-text mb-5">
        Garden Rhythms
      </h2>
      <p class="text-text/75 mb-12 leading-relaxed max-w-2xl" set:html={inline(copy.rhythmsIntro)} />

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-10 gap-y-14">
        {gardenRhythms.map(({ data: tip, Content }) => (
          <div class="group">
            <div class="overflow-hidden rounded-sm mb-6">
              <SmartImage
                src={tip.image}
                alt={tip.title}
                widths={[400, 800, 1200]}
                sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                class="w-full h-60 sm:h-64 object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
              />
            </div>
            <p class="text-[0.68rem] font-semibold text-marigold uppercase tracking-[0.2em] mb-2">
              {tip.frequency}
            </p>
            <h3 class="font-heading text-2xl font-semibold text-text mb-2.5">{tip.title}</h3>
            <Prose class="text-base text-text/75"><Content /></Prose>
          </div>
        ))}
      </div>
    </section>

  </div>
</BaseLayout>
