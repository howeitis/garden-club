---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import OptImage from '../../components/OptImage.astro';
import { clubInfo, gardeningTips } from '../../data/index';

const { evergreen: evergreenTips, rhythms: gardenRhythms } = gardeningTips;
---

<BaseLayout
  title={`Gardening Tips | ${clubInfo.name}`}
  description={`Evergreen fundamentals and seasonal Garden Rhythms — tips from ${clubInfo.name}.`}
>

  <PageHero
    eyebrow="Grow Better"
    title="Gardening Tips"
    subtitle="Timeless fundamentals plus seasonal routines to keep your garden thriving."
    image="/gardentools.webp"
  />

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-20">

    <!-- Evergreen Tips -->
    <section aria-labelledby="evergreen-heading" class="fade-in-section">
      <SectionHeader label="Always True" tone="blossom" icon="blossom" />
      <h2 id="evergreen-heading" class="font-heading text-3xl font-bold text-text mb-4">
        Evergreen Tips
      </h2>
      <p class="text-text/65 mb-10 text-sm leading-relaxed max-w-2xl">
        Whether you're a seasoned gardener or just getting started, these fundamentals will help
        your garden thrive year after year.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {evergreenTips.map((tip) => (
          <div class="bg-white rounded-xl border border-accent/20 shadow-sm overflow-hidden hover:shadow-lg transition-all duration-300 group">
            <div class="overflow-hidden">
              <OptImage
                path={tip.image}
                alt={tip.title}
                class="w-full h-64 sm:h-72 object-cover transition-transform duration-500 group-hover:scale-105"
                widths={[400, 800]}
                sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
              />
            </div>
            <div class="p-6">
              <h3 class="font-heading text-xl font-semibold text-text mb-3">{tip.title}</h3>
              <p class="text-sm text-text/70 leading-relaxed">{tip.description}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Garden Rhythms -->
    <section aria-labelledby="rhythms-heading" class="fade-in-section">
      <SectionHeader label="In Season" tone="marigold" icon="leaf" />
      <h2 id="rhythms-heading" class="font-heading text-3xl font-bold text-text mb-4">
        Garden Rhythms
      </h2>
      <p class="text-text/65 mb-10 text-sm leading-relaxed max-w-2xl">
        The recurring tasks that keep a garden humming through the growing season — each with the
        science behind <em>why</em> it works.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {gardenRhythms.map((tip) => (
          <div class="bg-white rounded-xl border border-marigold/25 shadow-sm overflow-hidden hover:shadow-lg transition-all duration-300 group">
            <div class="overflow-hidden">
              <OptImage
                path={tip.image}
                alt={tip.title}
                class="w-full h-64 sm:h-72 object-cover transition-transform duration-500 group-hover:scale-105"
                widths={[400, 800]}
                sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
              />
            </div>
            <div class="p-6">
              <div class="flex flex-wrap items-baseline justify-between gap-2 mb-2">
                <h3 class="font-heading text-xl font-semibold text-text">{tip.title}</h3>
              </div>
              <p class="text-xs font-semibold text-marigold-deep uppercase tracking-wide mb-3">
                {tip.frequency}
              </p>
              <p class="text-sm text-text/70 leading-relaxed">{tip.description}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

  </div>
</BaseLayout>
