---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import GardenCard from '../../components/GardenCard.astro';
import { club, gardens, getPageCopy } from '../../data/index';

const copy = await getPageCopy('gardens');
const localGardens = gardens.filter((g) => g.data.region === 'local');
const regionalGardens = gardens.filter((g) => g.data.region === 'regional');

---

<BaseLayout
  title={`Public Gardens to Visit Near Wilmington, DE | ${club.name}`}
  description={`Longwood, Winterthur, Mt. Cuba, Chanticleer, and more — public gardens in the Brandywine Valley and greater Philadelphia worth a day trip, recommended by ${club.name}.`}
>
  <PageHero
    eyebrow="Explore"
    title="Gardens to Visit"
    subtitle={copy.heroSubtitle}
    accent="hen"
  />

  <Breadcrumb items={[{ label: 'Resources', href: '/resources' }, { label: 'Gardens to Visit' }]} />

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-20">

    <section aria-labelledby="local-heading" class="fade-in-section">
      <SectionHeader label="Close to Home" number="01" />
      <h2 id="local-heading" class="font-heading text-4xl sm:text-5xl font-semibold tracking-[-0.01em] text-text mb-5">
        Local Gardens
      </h2>
      <p class="text-text/75 mb-12 leading-relaxed max-w-2xl">{copy.localIntro}</p>

      <div class="divide-y divide-gold/20">
        {localGardens.map((g, i) => <GardenCard garden={g} flip={i % 2 === 1} />)}
      </div>
    </section>

    <section aria-labelledby="regional-heading" class="fade-in-section">
      <SectionHeader label="Worth the Drive" number="02" />
      <h2 id="regional-heading" class="font-heading text-4xl sm:text-5xl font-semibold tracking-[-0.01em] text-text mb-5">
        Regional Gardens
      </h2>
      <p class="text-text/75 mb-12 leading-relaxed max-w-2xl">{copy.regionalIntro}</p>

      <div class="divide-y divide-gold/20">
        {regionalGardens.map((g, i) => <GardenCard garden={g} flip={i % 2 === 1} />)}
      </div>
    </section>

  </div>
</BaseLayout>
