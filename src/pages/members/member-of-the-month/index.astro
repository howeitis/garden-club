---
// Member of the Month — the current honoree's full profile, with past
// honorees collected in a grid below. Everything comes from
// src/data/membersOfTheMonth.json; the first entry is the current feature.
//
// Every honoree also has a permanent page at /members/member-of-the-month/
// <slug>/ (see [slug].astro). This index mirrors the current one, so it
// canonicalizes to that permanent URL: shares of either address consolidate
// there, and the link keeps working after the next honoree takes over here.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import MemberProfile from '../../../components/MemberProfile.astro';
import HonoreeGrid from '../../../components/HonoreeGrid.astro';
import Flourish from '../../../components/Flourish.astro';
import { clubInfo, membersOfTheMonth, currentMemberOfTheMonth as member } from '../../../data/index';
import { honoreePath, honoreeShareImage } from '../../../lib/memberOfTheMonth';

const pastHonorees = membersOfTheMonth.slice(1);
const shareImage = await honoreeShareImage(member, Astro.site);
---

<BaseLayout
  title={`Member of the Month · ${member.name} | ${clubInfo.name}`}
  description={`${member.headline} ${member.tagline}. ${member.summary}`}
  canonical={honoreePath(member)}
  ogImage={shareImage}
  ogImageAlt={member.photos.portrait.alt}
  ogType="article"
>
  <PageHero
    eyebrow="Our Members"
    title="Member of the Month"
    subtitle="Celebrating the people who make Garden Gate bloom."
    image="/flower.jpg"
    accent="blossom"
  />

  <Breadcrumb items={[{ label: 'Members', href: '/members' }, { label: 'Member of the Month' }]} />

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-24">

    <MemberProfile member={member} />

    <HonoreeGrid honorees={pastHonorees} eyebrow="The Archive" title="Past Honorees" />

    <!-- ── Closing ─────────────────────────────────────────────────────── -->
    <section class="text-center fade-in-section">
      <Flourish class="mb-9" />
      <h2 class="font-heading text-3xl sm:text-4xl font-semibold text-text mb-4">Meet More of Our Members</h2>
      <p class="text-text/70 text-lg leading-relaxed max-w-xl mx-auto mb-8">
        Wander through the gardens our members tend at home, or meet the club's certified judges.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a
          href="/members"
          class="inline-flex items-center gap-2.5 bg-primary text-background text-[0.8rem] font-semibold uppercase tracking-[0.18em] px-9 py-4 rounded-sm hover:bg-[#1f4128] transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-gold focus:ring-offset-2"
        >
          Member Gardens
        </a>
        <a
          href="/members/awards-and-judges"
          class="inline-flex items-center gap-2.5 border border-primary/30 text-primary text-[0.8rem] font-semibold uppercase tracking-[0.18em] px-9 py-4 rounded-sm hover:border-primary hover:bg-white transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-gold focus:ring-offset-2"
        >
          Awards &amp; Judges
        </a>
      </div>
    </section>

  </div>
</BaseLayout>
