---
// Permanent page for one Member of the Month honoree, generated for every
// entry in src/data/membersOfTheMonth.json. This is the URL to share: it
// survives the honoree rolling off the index, carries their portrait as the
// share image, and describes them to search engines as a Person.
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import MemberProfile from '../../../components/MemberProfile.astro';
import HonoreeGrid from '../../../components/HonoreeGrid.astro';
import Flourish from '../../../components/Flourish.astro';
import { clubInfo, membersOfTheMonth, currentMemberOfTheMonth } from '../../../data/index';
import { MEMBER_OF_THE_MONTH_BASE, honoreePath, honoreeShareImage } from '../../../lib/memberOfTheMonth';

export const getStaticPaths = (() =>
  membersOfTheMonth.map((member) => ({ params: { slug: member.slug }, props: { member } }))
) satisfies GetStaticPaths;

const { member } = Astro.props;
const isCurrent = member.slug === currentMemberOfTheMonth.slug;
const otherHonorees = membersOfTheMonth.filter((m) => m.slug !== member.slug);
const shareImage = await honoreeShareImage(member, Astro.site);

const personJsonLd = {
  '@type': 'Person',
  name: member.name,
  description: member.summary,
  image: shareImage,
  url: new URL(honoreePath(member), Astro.site).toString(),
  memberOf: { '@id': new URL('/#organization', Astro.site).toString() },
  ...(member.period ? { award: `${clubInfo.name} Member of the Month, ${member.period}` } : {}),
};
---

<BaseLayout
  title={`${member.name} — Member of the Month | ${clubInfo.name}`}
  description={`${member.headline} ${member.tagline}. ${member.summary}`}
  ogImage={shareImage}
  ogImageAlt={member.photos.portrait.alt}
  ogType="article"
  jsonLd={[personJsonLd]}
>
  <PageHero
    eyebrow="Our Members"
    title="Member of the Month"
    subtitle="Celebrating the people who make Garden Gate bloom."
    image="/flower.jpg"
    accent="blossom"
  />

  <Breadcrumb items={[
    { label: 'Members', href: '/members' },
    { label: 'Member of the Month', href: `${MEMBER_OF_THE_MONTH_BASE}/` },
    { label: member.name },
  ]} />

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-24">

    <MemberProfile member={member} />

    <HonoreeGrid
      honorees={otherHonorees}
      eyebrow={isCurrent ? 'The Archive' : 'More Honorees'}
      title={isCurrent ? 'Past Honorees' : 'More Members of the Month'}
    />

    <!-- ── Closing ─────────────────────────────────────────────────────── -->
    <section class="text-center fade-in-section">
      <Flourish class="mb-9" />
      <h2 class="font-heading text-3xl sm:text-4xl font-semibold text-text mb-4">Meet More of Our Members</h2>
      <p class="text-text/70 text-lg leading-relaxed max-w-xl mx-auto mb-8">
        Wander through the gardens our members tend at home, or meet the club's certified judges.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a
          href="/members"
          class="inline-flex items-center gap-2.5 bg-primary text-background text-[0.8rem] font-semibold uppercase tracking-[0.18em] px-9 py-4 rounded-sm hover:bg-[#1f4128] transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-gold focus:ring-offset-2"
        >
          Member Gardens
        </a>
        <a
          href="/members/awards-and-judges"
          class="inline-flex items-center gap-2.5 border border-primary/30 text-primary text-[0.8rem] font-semibold uppercase tracking-[0.18em] px-9 py-4 rounded-sm hover:border-primary hover:bg-white transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-gold focus:ring-offset-2"
        >
          Awards &amp; Judges
        </a>
      </div>
    </section>

  </div>
</BaseLayout>
