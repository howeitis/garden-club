---
// Permanent page for one Member of the Month honoree, generated for every
// file in src/content/members-of-the-month/. This is the URL to share: it
// survives the honoree rolling off the index, carries their portrait as the
// share image, and describes them to search engines as a Person.
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import MemberProfile from '../../../components/MemberProfile.astro';
import HonoreeGrid from '../../../components/HonoreeGrid.astro';
import Flourish from '../../../components/Flourish.astro';
import { club, membersOfTheMonth, currentMemberOfTheMonth, honoreePeriod, getPageCopy } from '../../../data/index';
import { MEMBER_OF_THE_MONTH_BASE, honoreePath, honoreeShareImage } from '../../../lib/memberOfTheMonth';
import Button from '../../../components/Button.astro';

export const getStaticPaths = (() =>
  membersOfTheMonth.map((member) => ({ params: { slug: member.id }, props: { member } }))
) satisfies GetStaticPaths;

const { member } = Astro.props;
const copy = await getPageCopy('member-of-the-month');
const isCurrent = member.id === currentMemberOfTheMonth.id;
const otherHonorees = membersOfTheMonth.filter((m) => m.id !== member.id);
const period = honoreePeriod(member);
const shareImage = await honoreeShareImage(member, Astro.site);

const personJsonLd = {
  '@type': 'Person',
  name: member.data.name,
  description: member.data.summary,
  image: shareImage,
  url: new URL(honoreePath(member), Astro.site).toString(),
  memberOf: { '@id': new URL('/#organization', Astro.site).toString() },
  ...(period ? { award: `${club.name} Member of the Month, ${period}` } : {}),
};
---

<BaseLayout
  title={`${member.data.name} — Member of the Month | ${club.name}`}
  description={`${member.data.headline} ${member.data.tagline}. ${member.data.summary}`}
  ogImage={shareImage}
  ogImageAlt={member.data.portrait.alt}
  ogType="article"
  jsonLd={[personJsonLd]}
>
  <PageHero
    eyebrow="Our Members"
    title="Member of the Month"
    subtitle={copy.heroSubtitle}
    image="/flower.jpg"
    accent="blossom"
  />

  <Breadcrumb items={[
    { label: 'Members', href: '/members/' },
    { label: 'Member of the Month', href: `${MEMBER_OF_THE_MONTH_BASE}/` },
    { label: member.data.name },
  ]} />

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-24">

    <MemberProfile member={member} />

    <HonoreeGrid
      honorees={otherHonorees}
      eyebrow={isCurrent ? 'The Archive' : 'More Honorees'}
      title={isCurrent ? 'Past Honorees' : 'More Members of the Month'}
    />

    <!-- ── Closing ─────────────────────────────────────────────────────── -->
    <section class="text-center fade-in-section">
      <Flourish class="mb-9" />
      <h2 class="font-heading text-3xl sm:text-4xl font-semibold text-text mb-4">Meet More of Our Members</h2>
      <p class="text-text/70 text-lg leading-relaxed max-w-xl mx-auto mb-8">
        Wander through the gardens our members tend at home, or meet the club's certified judges.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <Button href="/members/">Member Gardens</Button>
        <Button href="/members/awards-and-judges/" variant="outline">Awards &amp; Judges</Button>
      </div>
    </section>

  </div>
</BaseLayout>
