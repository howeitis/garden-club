---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import AwardCard from '../../components/AwardCard.astro';
import JudgeRow from '../../components/JudgeRow.astro';
import { clubInfo, awards, judges } from '../../data/index';

const activeJudges   = judges.filter((j) => j.status === 'active');
const emeritusJudges = judges.filter((j) => j.status === 'emeritus');

// Split awards by category
const dfgcAwards = awards.filter((a) => a.category === 'DFGC');
const gggcAwards = awards.filter((a) => a.category === 'GGGC');
---

<BaseLayout
  title={`Awards & Judges | ${clubInfo.name}`}
  description={`Club awards, judging criteria, and certified judges of ${clubInfo.name}.`}
>
  <PageHero
    eyebrow="Recognition"
    title="Awards &amp; Judges"
    image="/awards-hero.jpg"
    accent="holly"
  />

  <!-- Breadcrumb -->
  <nav class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-8" aria-label="Breadcrumb">
    <ol class="flex items-center gap-2.5 text-sm text-text/50">
      <li><a href="/members" class="hover:text-primary underline decoration-gold/30 underline-offset-4 transition-colors">Members</a></li>
      <li aria-hidden="true" class="text-gold/60">&middot;</li>
      <li class="text-text/80 font-medium" aria-current="page">Awards &amp; Judges</li>
    </ol>
  </nav>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-24">

    <!-- DFGC Awards -->
    {dfgcAwards.length > 0 && (
      <section aria-labelledby="dfgc-awards-heading">
        <SectionHeader label="State Federation" number="01" />
        <h2 id="dfgc-awards-heading" class="font-heading text-4xl sm:text-5xl font-semibold tracking-[-0.01em] text-text mb-10">
          Delaware Federation Awards
        </h2>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-x-14 gap-y-12">
          {dfgcAwards.map((award) => (
            <AwardCard award={award} />
          ))}
        </div>
      </section>
    )}

    <!-- GGGC Awards (CEW Training Award) -->
    {gggcAwards.length > 0 && (
      <section aria-labelledby="gggc-awards-heading">
        <SectionHeader label="Garden Gate" number="02" />
        <h2 id="gggc-awards-heading" class="font-heading text-4xl sm:text-5xl font-semibold tracking-[-0.01em] text-text mb-10">
          Club Awards
        </h2>
        <div class="grid grid-cols-1 gap-y-12">
          {gggcAwards.map((award) => (
            <AwardCard award={award} />
          ))}
        </div>
      </section>
    )}

    <!-- Judges Section -->
    <section aria-labelledby="judges-heading">
      <SectionHeader label="Accredited Expertise" number="03" />
      <h2 id="judges-heading" class="font-heading text-4xl sm:text-5xl font-semibold tracking-[-0.01em] text-text mb-5">
        Certified Judges
      </h2>
      <p class="text-text/75 mb-10 leading-relaxed max-w-2xl">
        Our accredited judges have completed training through the National Garden Clubs, Inc. and
        bring expertise in horticulture, floral design, and landscape evaluation.
      </p>

      <!-- Active Judges -->
      {activeJudges.length > 0 && (
        <div class="mb-12 max-w-3xl">
          <h3 class="text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-gold pb-3 border-b border-gold/40">Active Judges</h3>
          <ul class="divide-y divide-primary/10" role="list" aria-label="Active judges">
            {activeJudges.map((judge) => (
              <JudgeRow judge={judge} />
            ))}
          </ul>
        </div>
      )}

      <!-- Emeritus Judges -->
      {emeritusJudges.length > 0 && (
        <div class="max-w-3xl">
          <h3 class="text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-text/50 pb-3 border-b border-gold/40">Emeritus Judges</h3>
          <ul class="divide-y divide-primary/10" role="list" aria-label="Emeritus judges">
            {emeritusJudges.map((judge) => (
              <JudgeRow judge={judge} />
            ))}
          </ul>
        </div>
      )}
    </section>

  </div>
</BaseLayout>
