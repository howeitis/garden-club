---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AwardCard from '../../components/AwardCard.astro';
import JudgeRow from '../../components/JudgeRow.astro';
import { clubInfo, awards, judges } from '../../data/index';

const activeJudges   = judges.filter((j) => j.status === 'active');
const emeritusJudges = judges.filter((j) => j.status === 'emeritus');

// Split awards by category
const dfgcAwards = awards.filter((a) => a.category === 'DFGC');
const gggcAwards = awards.filter((a) => a.category === 'GGGC');
---

<BaseLayout
  title={`Awards & Judges | ${clubInfo.name}`}
  description={`Club awards, judging criteria, and certified judges of ${clubInfo.name}.`}
>

  <!-- Page Header -->
  <section class="relative bg-primary text-background py-16 sm:py-24 overflow-hidden">
    <div class="absolute inset-0">
      <img src="/awards-hero.jpg" alt="" class="w-full h-full object-cover opacity-40 mix-blend-overlay" loading="eager" />
      <div class="absolute inset-0 bg-primary/40" aria-hidden="true"></div>
    </div>
    <div class="absolute top-6 right-12 text-5xl opacity-15 rotate-6 select-none pointer-events-none" aria-hidden="true">🏅</div>
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-blossom text-xs font-semibold uppercase tracking-widest mb-3">Recognition</p>
      <h1 class="font-heading text-4xl sm:text-5xl font-bold leading-tight">Awards &amp; Judges</h1>
    </div>
  </section>

  <!-- Breadcrumb -->
  <nav class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-6" aria-label="Breadcrumb">
    <ol class="flex items-center gap-2 text-sm text-text/50">
      <li><a href="/members" class="hover:text-primary transition-colors">Members</a></li>
      <li aria-hidden="true">/</li>
      <li class="text-text/80 font-medium" aria-current="page">Awards &amp; Judges</li>
    </ol>
  </nav>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-20">

    <!-- DFGC Awards -->
    {dfgcAwards.length > 0 && (
      <section aria-labelledby="dfgc-awards-heading">
        <div class="flex items-center gap-3 mb-8">
          <h2 id="dfgc-awards-heading" class="font-heading text-3xl font-bold text-text">
            Delaware Federation Awards
          </h2>
          <span class="text-xs font-semibold uppercase tracking-wide px-3 py-1 rounded-full bg-holly/12 text-holly self-center border border-holly/20">
            DFGC
          </span>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          {dfgcAwards.map((award) => (
            <AwardCard award={award} />
          ))}
        </div>
      </section>
    )}

    <!-- GGGC Awards (CEW Training Award) -->
    {gggcAwards.length > 0 && (
      <section aria-labelledby="gggc-awards-heading">
        <div class="flex items-center gap-3 mb-8">
          <h2 id="gggc-awards-heading" class="font-heading text-3xl font-bold text-text">
            Club Awards
          </h2>
          <span class="text-xs font-semibold uppercase tracking-wide px-3 py-1 rounded-full bg-blossom/25 text-blossom-deep self-center border border-blossom/30">
            GGGC
          </span>
        </div>
        <div class="grid grid-cols-1 gap-6">
          {gggcAwards.map((award) => (
            <AwardCard award={award} />
          ))}
        </div>
      </section>
    )}

    <!-- Judges Section -->
    <section aria-labelledby="judges-heading">
      <div class="flex items-center gap-3 mb-4">
        <h2 id="judges-heading" class="font-heading text-3xl font-bold text-text">
          Certified Judges
        </h2>
        <span class="text-xl" aria-hidden="true">🌷</span>
      </div>
      <p class="text-text/65 mb-8 text-sm leading-relaxed max-w-2xl">
        Our accredited judges have completed training through the National Garden Clubs, Inc. and
        bring expertise in horticulture, floral design, and landscape evaluation.
      </p>

      <!-- Active Judges -->
      {activeJudges.length > 0 && (
        <div class="bg-white rounded-xl border border-blossom/25 shadow-sm overflow-hidden mb-8">
          <div class="px-6 py-4 bg-gradient-to-r from-blossom/15 to-blossom/5 border-b border-blossom/20">
            <h3 class="text-sm font-semibold uppercase tracking-widest text-holly">Active Judges</h3>
          </div>
          <ul class="px-6" role="list" aria-label="Active judges">
            {activeJudges.map((judge) => (
              <JudgeRow judge={judge} />
            ))}
          </ul>
        </div>
      )}

      <!-- Emeritus Judges -->
      {emeritusJudges.length > 0 && (
        <div class="bg-white rounded-xl border border-lavender/30 shadow-sm overflow-hidden">
          <div class="px-6 py-4 bg-gradient-to-r from-lavender/15 to-lavender/5 border-b border-lavender/25">
            <h3 class="text-sm font-semibold uppercase tracking-widest text-primary">Emeritus Judges</h3>
          </div>
          <ul class="px-6" role="list" aria-label="Emeritus judges">
            {emeritusJudges.map((judge) => (
              <JudgeRow judge={judge} />
            ))}
          </ul>
        </div>
      )}
    </section>

  </div>
</BaseLayout>
