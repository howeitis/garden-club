---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import SmartImage from '../../components/SmartImage.astro';
import { clubInfo } from '../../data/index';

const memberGardens = [
  {
    name: 'Pollinator Paradise',
    member: 'Rita Thompson',
    description:
      'Designed with wildlife in mind, this sunny border garden is packed with Purple Coneflower, Black-eyed Susans, Anise Hyssop, Common Yarrow, and Mexican Sunflower to attract butterflies, bees, and hummingbirds throughout the season.',
    highlight: 'Certified wildlife habitat',
    image: '/pollinatorparadise.webp',
    // Portrait photo — bias the crop upward so the monarch butterfly stays
    // in frame when the wide card crops the top and bottom of the image.
    imagePosition: 'center 35%',
  },
  {
    name: 'Birdbath Bloomery',
    member: 'Chris Metzler',
    description:
      'A sunny cottage-style border anchored by a classic white birdbath and overflowing with Black-eyed Susans, Marigolds, Surprise Lilies, and Shrub Roses for layered color from midsummer into fall.',
    highlight: 'Cottage-style borders',
    image: '/metzlers.webp',
  },
  {
    name: 'The Rose Walk',
    member: 'Jane Doe',
    description:
      'A winding gravel path bordered by David Austin English roses and fragrant lavender. Visitors are welcomed by a classic white arbor draped in climbing New Dawn roses.',
    highlight: 'Over 40 rose varieties',
    image: '/rosegarden.webp',
  },
  {
    name: 'Shade Sanctuary',
    member: 'Mary Smith',
    description:
      'Nestled beneath mature oaks, this woodland garden showcases native ferns, hostas, and hellebores. A small water feature provides a tranquil backdrop for shade-loving perennials.',
    highlight: 'Native woodland plants',
    image: '/shadegarden.webp',
  },
];
---

<BaseLayout
  title={`Members | ${clubInfo.name}`}
  description={`Meet the members of ${clubInfo.name} and explore their beautiful home gardens.`}
>
  <PageHero
    eyebrow="Our Members"
    title="Members"
    subtitle="Celebrating the gardeners who make our club bloom."
    image="/home-hero.png"
  />

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20 space-y-24">

    <!-- Featured Member Gardens -->
    <section aria-labelledby="gardens-heading" class="fade-in-section">
      <SectionHeader label="From Our Backyards" />
      <h2 id="gardens-heading" class="font-heading text-4xl font-semibold text-text mb-5">
        Featured Member Gardens
      </h2>
      <p class="text-text/75 mb-12 leading-relaxed max-w-2xl">
        Each season we spotlight gardens from our members. From cottage borders to productive kitchen
        gardens, our club is home to a wonderful variety of gardening styles.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {memberGardens.map((garden) => (
          <div class="bg-white rounded-sm border border-primary/10 shadow-[0_1px_3px_rgba(51,50,44,0.06)] overflow-hidden hover:shadow-[0_6px_20px_rgba(51,50,44,0.1)] transition-shadow duration-300 group">
            <div class="h-64 sm:h-72 overflow-hidden">
              <SmartImage
                src={garden.image}
                alt={garden.name}
                widths={[400, 800, 1200]}
                sizes="(min-width: 768px) 50vw, 100vw"
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                style={garden.imagePosition ? `object-position: ${garden.imagePosition}` : undefined}
                loading="lazy"
              />
            </div>
            <div class="p-6 sm:p-7">
              <h3 class="font-heading text-2xl font-semibold text-text mb-1">{garden.name}</h3>
              <p class="text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-gold mb-3.5">Gardener: {garden.member}</p>
              <p class="text-base text-text/75 leading-relaxed mb-5">{garden.description}</p>
              <span class="inline-block text-[0.65rem] font-semibold uppercase tracking-[0.16em] px-2.5 py-1 rounded-sm border border-accent/50 text-primary">
                {garden.highlight}
              </span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Awards & Judges CTA -->
    <section class="border-y border-gold/25 px-6 py-14 text-center fade-in-section">
      <h2 class="font-heading text-3xl sm:text-4xl font-semibold text-text mb-4">Awards &amp; Judges</h2>
      <p class="text-text/70 text-lg leading-relaxed max-w-xl mx-auto mb-8">
        Learn about our club and Delaware Federation awards, judging criteria, and meet our
        certified judges.
      </p>
      <a
        href="/members/awards-and-judges"
        class="inline-flex items-center gap-2.5 bg-primary text-background text-[0.8rem] font-semibold uppercase tracking-[0.18em] px-9 py-4 rounded-sm hover:bg-[#1f4128] transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-gold focus:ring-offset-2"
      >
        View Awards &amp; Judges
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </section>

  </div>
</BaseLayout>
