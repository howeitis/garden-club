---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { clubInfo } from '../../data/index';

const memberGardens = [
  {
    name: 'Pollinator Paradise',
    member: 'Rita Thompson',
    description:
      'Designed with wildlife in mind, this sunny border garden is packed with Purple Coneflower, Black-eyed Susans, Anise Hyssop, Common Yarrow, and Mexican Sunflower to attract butterflies, bees, and hummingbirds throughout the season.',
    highlight: 'Certified wildlife habitat',
    image: '/pollinatorparadise.webp',
    // Portrait photo — bias the crop upward so the monarch butterfly stays
    // in frame when the wide card crops the top and bottom of the image.
    imagePosition: 'center 35%',
  },
  {
    name: 'Birdbath Bloomery',
    member: 'Chris Metzler',
    description:
      'A sunny cottage-style border anchored by a classic white birdbath and overflowing with Black-eyed Susans, Marigolds, Surprise Lilies, and Shrub Roses for layered color from midsummer into fall.',
    highlight: 'Cottage-style borders',
    image: '/metzlers.webp',
  },
  {
    name: 'The Rose Walk',
    member: 'Jane Doe',
    description:
      'A winding gravel path bordered by David Austin English roses and fragrant lavender. Visitors are welcomed by a classic white arbor draped in climbing New Dawn roses.',
    highlight: 'Over 40 rose varieties',
    image: '/rosegarden.webp',
  },
  {
    name: 'Shade Sanctuary',
    member: 'Mary Smith',
    description:
      'Nestled beneath mature oaks, this woodland garden showcases native ferns, hostas, and hellebores. A small water feature provides a tranquil backdrop for shade-loving perennials.',
    highlight: 'Native woodland plants',
    image: '/shadegarden.webp',
  },
];
---

<BaseLayout
  title={`Members | ${clubInfo.name}`}
  description={`Meet the members of ${clubInfo.name} and explore their beautiful home gardens.`}
>
  <PageHero
    eyebrow="Our Members"
    title="Members"
    subtitle="Celebrating the gardeners who make our club bloom."
    image="/home-hero.png"
  />

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-20">

    <!-- Featured Member Gardens -->
    <section aria-labelledby="gardens-heading" class="fade-in-section">
      <h2 id="gardens-heading" class="font-heading text-3xl font-bold text-text mb-4">
        Featured Member Gardens
      </h2>
      <p class="text-text/65 mb-10 text-sm leading-relaxed max-w-2xl">
        Each season we spotlight gardens from our members. From cottage borders to productive kitchen
        gardens, our club is home to a wonderful variety of gardening styles.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {memberGardens.map((garden) => (
          <div class="bg-white rounded-xl border border-accent/20 shadow-sm overflow-hidden hover:shadow-md transition-shadow duration-200 group">
            <div class="h-64 sm:h-72 overflow-hidden">
              <img
                src={garden.image}
                alt={garden.name}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                style={garden.imagePosition ? `object-position: ${garden.imagePosition}` : undefined}
                loading="lazy"
              />
            </div>
            <div class="p-6">
              <div class="flex items-center gap-2 mb-2">
                <h3 class="font-heading text-xl font-semibold text-text">{garden.name}</h3>
              </div>
              <p class="text-xs font-medium text-primary mb-3">Gardener: {garden.member}</p>
              <p class="text-sm text-text/70 leading-relaxed mb-4">{garden.description}</p>
              <span class="inline-block text-xs font-semibold uppercase tracking-wide px-3 py-1 rounded-full bg-accent/15 text-primary">
                {garden.highlight}
              </span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Awards & Judges CTA -->
    <section class="bg-gradient-to-br from-marigold/15 via-sunflower/10 to-hen/10 border border-marigold/30 rounded-xl p-8 text-center fade-in-section">
      <h2 class="font-heading text-2xl font-bold text-text mb-3">Awards &amp; Judges</h2>
      <p class="text-text/65 text-sm leading-relaxed max-w-xl mx-auto mb-6">
        Learn about our club and Delaware Federation awards, judging criteria, and meet our
        certified judges.
      </p>
      <a
        href="/members/awards-and-judges"
        class="inline-flex items-center gap-2 bg-primary text-background font-semibold px-8 py-3 rounded-lg hover:bg-primary/90 transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2"
      >
        View Awards &amp; Judges
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </section>

  </div>
</BaseLayout>
