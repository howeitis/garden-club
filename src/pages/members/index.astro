---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import SmartImage from '../../components/SmartImage.astro';
import Flourish from '../../components/Flourish.astro';
import Prose from '../../components/Prose.astro';
import { render } from 'astro:content';
import { club, memberGardens, currentMemberOfTheMonth as featured, honoreePeriod, getPageCopy } from '../../data/index';
import { honoreePath } from '../../lib/memberOfTheMonth';
import Button from '../../components/Button.astro';
import ArrowIcon from '../../components/ArrowIcon.astro';

const copy = await getPageCopy('members');
const featuredPeriod = honoreePeriod(featured);
// Render each garden's Markdown description up front so the template stays flat.
const gardens = await Promise.all(memberGardens.map(async (garden) => ({ ...garden, Content: (await render(garden)).Content })));

---

<BaseLayout
  title={`Member Gardens | ${club.name}`}
  description={`Home gardens tended by ${club.name} members in and around Greenville, Delaware, plus our current Member of the Month.`}
>
  <PageHero
    eyebrow="Our Members"
    title="Members"
    subtitle={copy.heroSubtitle}
    image="/home-hero.webp"
    accent="lavender"
  />

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20 space-y-24">

    <!-- Member of the Month callout -->
    <section aria-labelledby="motm-heading" class="fade-in-section">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-14 items-center">
        <a href={honoreePath(featured)} class="md:col-span-4 block group" aria-hidden="true" tabindex="-1">
          <div class="relative">
            <span class="absolute -top-3 -left-3 w-10 h-10 border-t-2 border-l-2 border-blossom/70" aria-hidden="true"></span>
            <span class="absolute -bottom-3 -right-3 w-10 h-10 border-b-2 border-r-2 border-gold/50" aria-hidden="true"></span>
            <SmartImage
              src={featured.data.portrait.image}
              alt=""
              widths={[400, 800]}
              sizes="(min-width: 768px) 33vw, 100vw"
              class="w-full aspect-[3/4] object-cover rounded-sm transition-transform duration-500 group-hover:scale-[1.02]"
              style={featured.data.portrait.focus ? `object-position: ${featured.data.portrait.focus}` : undefined}
              loading="lazy"
            />
          </div>
        </a>
        <div class="md:col-span-8">
          <SectionHeader label={featuredPeriod ? `Member of the Month · ${featuredPeriod}` : 'Member of the Month'} />
          <h2 id="motm-heading" class="font-heading font-semibold tracking-[-0.01em] text-text leading-[1.02] mb-5">
            <span class="block text-4xl sm:text-5xl lg:text-6xl">{featured.data.headline}</span>
            <span class="mt-2 block font-normal italic text-2xl sm:text-3xl text-blossom-deep">{featured.data.tagline}</span>
          </h2>
          <p class="text-text/75 text-lg leading-relaxed max-w-2xl mb-8">{featured.data.summary}</p>
          <Button href={honoreePath(featured)} arrow>Read {featured.data.name.split(' ')[0]}'s Story</Button>
        </div>
      </div>
      <Flourish class="mt-20" />
    </section>

    <!-- Featured Member Gardens -->
    <section aria-labelledby="gardens-heading" class="fade-in-section">
      <SectionHeader label="From Our Backyards" />
      <h2 id="gardens-heading" class="font-heading text-4xl sm:text-5xl font-semibold tracking-[-0.01em] text-text mb-5">
        Featured Member Gardens
      </h2>
      <p class="text-text/75 mb-12 leading-relaxed max-w-2xl">{copy.gardensIntro}</p>

      <div class="divide-y divide-gold/20">
        {gardens.map(({ data: garden, Content }, i) => (
          <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-14 items-center py-14 first:pt-0 last:pb-0">
            <div class:list={['md:col-span-7 overflow-hidden rounded-sm', i % 2 === 1 && 'md:order-2']}>
              <SmartImage
                src={garden.image}
                alt={garden.name}
                widths={[400, 800, 1200]}
                sizes="(min-width: 768px) 58vw, 100vw"
                class="w-full h-64 sm:h-96 object-cover"
                style={garden.focus ? `object-position: ${garden.focus}` : undefined}
                loading="lazy"
              />
            </div>
            <div class:list={['md:col-span-5', i % 2 === 1 && 'md:order-1']}>
              <p class="text-[0.68rem] font-semibold uppercase tracking-[0.22em] text-blossom-deep mb-3">Gardener: {garden.gardener}</p>
              <h3 class="font-heading text-3xl font-semibold text-text mb-4 leading-snug">{garden.name}</h3>
              <Prose class="text-base sm:text-lg text-text/75 mb-6"><Content /></Prose>
              {garden.highlight && (
                <span class="inline-block text-[0.65rem] font-semibold uppercase tracking-[0.16em] px-2.5 py-1 rounded-sm border border-accent/50 text-primary">
                  {garden.highlight}
                </span>
              )}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Awards & Judges CTA -->
    <section class="border-y border-gold/25 px-6 py-14 text-center fade-in-section">
      <h2 class="font-heading text-3xl sm:text-4xl font-semibold text-text mb-4">Awards &amp; Judges</h2>
      <p class="text-text/70 text-lg leading-relaxed max-w-xl mx-auto mb-8">
        Learn about our club and Delaware Federation awards, judging criteria, and meet our
        certified judges.
      </p>
      <Button href="/members/awards-and-judges/" arrow>View Awards &amp; Judges</Button>
    </section>

  </div>
</BaseLayout>
