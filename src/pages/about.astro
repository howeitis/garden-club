---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import OfficerCard from '../components/OfficerCard.astro';
import Prose from '../components/Prose.astro';
import SmartImage from '../components/SmartImage.astro';
import { club, officers, affiliations, getPageCopy } from '../data/index';
import { block } from '../lib/markdown';

const copy = await getPageCopy('about');
// Officers named "TBD" are already filtered out in src/data/index.ts; the
// section hides itself while the list is empty.
const sortedOfficers = officers;

// Each figure takes one hue from the logo's palette.
const membershipStats = [
  { label: 'Active Members',    value: club.membership.active,    color: 'text-primary' },
  { label: 'Associate Members', value: club.membership.associate, color: 'text-blossom-deep' },
  { label: 'Honorary Members',  value: club.membership.honorary,  color: 'text-marigold' },
];
---

<BaseLayout
  title={`About ${club.name} | Est. 1963, Greenville, Delaware`}
  description={`The history, board, and affiliations of ${club.name} — a National Garden Clubs member founded in Greenville, Delaware in ${club.founded}.`}
>
  <PageHero
    eyebrow="Our Story"
    title="About Us"
    image="/about-hero.jpg"
    accent="blossom"
  />

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20 space-y-24">

    <!-- Club History -->
    <section aria-labelledby="history-heading" class="fade-in-section">
      <div class="max-w-3xl">
        <SectionHeader label="Since 1963" number="01" />
        <h2 id="history-heading" class="font-heading text-4xl sm:text-5xl font-semibold tracking-[-0.01em] text-text mb-7">Our History</h2>
        <div class="text-text/80 text-lg">
          <Prose
            class="[&>p:first-child]:first-letter:font-heading [&>p:first-child]:first-letter:font-semibold [&>p:first-child]:first-letter:text-primary [&>p:first-child]:first-letter:text-[3.6em] [&>p:first-child]:first-letter:float-left [&>p:first-child]:first-letter:leading-[0.78] [&>p:first-child]:first-letter:mr-3 [&>p:first-child]:first-letter:mt-1"
            html={block(copy.history)}
          />
          <blockquote class="font-heading italic text-2xl sm:text-[1.7rem] text-text/85 border-l-2 border-gold/60 pl-7 py-2 leading-[1.35] mt-9 leading-relaxed">
            &ldquo;{club.mission}&rdquo;
          </blockquote>
        </div>

        <!-- Membership at a glance -->
        <div class="mt-12 grid grid-cols-3 border-y border-gold/25 divide-x divide-gold/15">
          {membershipStats.map((stat) => (
            <div class="py-6 px-3 text-center">
              <p class:list={['font-heading text-4xl font-semibold', stat.color]}>{stat.value}</p>
              <p class="text-[0.68rem] font-semibold uppercase tracking-[0.16em] text-text/70 mt-2 leading-snug">{stat.label}</p>
            </div>
          ))}
        </div>
        <p class="text-sm text-text/70 mt-4 leading-relaxed italic">
          {club.membership.note}
        </p>
      </div>
    </section>

    <!-- Board of Officers -->
    {sortedOfficers.length > 0 && (
      <section aria-labelledby="officers-heading" class="fade-in-section">
        <SectionHeader label="Leadership" number="02" />
        <h2 id="officers-heading" class="font-heading text-4xl sm:text-5xl font-semibold tracking-[-0.01em] text-text mb-10">
          Board of Officers
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-10 gap-y-12">
          {sortedOfficers.map((officer, i) => (
            <OfficerCard officer={officer} index={i} />
          ))}
        </div>
      </section>
    )}

    <!-- Affiliations -->
    <section aria-labelledby="affiliations-heading" class="fade-in-section">
      <SectionHeader label="Our Network" number={sortedOfficers.length > 0 ? '03' : '02'} />
      <h2 id="affiliations-heading" class="font-heading text-4xl sm:text-5xl font-semibold tracking-[-0.01em] text-text mb-10">
        Our Affiliations
      </h2>

      <!-- NGC — full detail entry -->
      <div class="border-t border-gold/30 pt-7 mb-12">
        <div class="flex items-start justify-between gap-4 mb-6">
          <div>
            <span class="text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-gold">National</span>
            <h3 class="font-heading text-2xl font-semibold text-text mt-1.5">{affiliations.national.name}</h3>
          </div>
          <SmartImage src="/ngc-logo.png" alt="NGC Logo" widths={[72, 144, 216]} sizes="72px" class="w-16 h-auto object-contain flex-shrink-0" loading="lazy" />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-10 gap-y-3 mb-6">
          <dl class="space-y-3">
            <div>
              <dt class="text-[0.65rem] font-semibold uppercase tracking-[0.16em] text-text/70">President</dt>
              <dd class="text-text/80 mt-0.5">{affiliations.national.president}</dd>
            </div>
            <div>
              <dt class="text-[0.65rem] font-semibold uppercase tracking-[0.16em] text-text/70">Email</dt>
              <dd class="mt-0.5">
                <a href={`mailto:${affiliations.national.presidentEmail}`}
                  class="text-primary underline decoration-gold/40 underline-offset-4 hover:decoration-gold">{affiliations.national.presidentEmail}</a>
              </dd>
            </div>
            <div>
              <dt class="text-[0.65rem] font-semibold uppercase tracking-[0.16em] text-text/70">Theme</dt>
              <dd class="font-heading italic text-lg text-text/75 mt-0.5">&ldquo;{affiliations.national.theme}&rdquo;</dd>
            </div>
          </dl>
          <dl class="space-y-3">
            <div>
              <dt class="text-[0.65rem] font-semibold uppercase tracking-[0.16em] text-text/70">Address</dt>
              <dd class="text-text/80 mt-0.5">{affiliations.national.address}</dd>
            </div>
            <div>
              <dt class="text-[0.65rem] font-semibold uppercase tracking-[0.16em] text-text/70">Phone</dt>
              <dd class="text-text/80 mt-0.5">{affiliations.national.phone}</dd>
            </div>
            <div>
              <dt class="text-[0.65rem] font-semibold uppercase tracking-[0.16em] text-text/70">Website</dt>
              <dd class="mt-0.5">
                <a href={`https://${affiliations.national.website}`} target="_blank" rel="noopener noreferrer"
                  class="text-primary underline decoration-gold/40 underline-offset-4 hover:decoration-gold">{affiliations.national.website}</a>
              </dd>
            </div>
          </dl>
        </div>

        <!-- Annual Convention (omit `convention` in affiliations.yml to hide) -->
        {affiliations.national.convention && (
          <div class="border-t border-gold/20 pt-5">
            <p class="text-[0.65rem] font-semibold uppercase tracking-[0.2em] text-gold mb-1.5">Annual Convention</p>
            <p class="text-text/80">
              <strong class="font-semibold">{affiliations.national.convention.dates}</strong> &mdash; {affiliations.national.convention.location}
            </p>
          </div>
        )}
      </div>

      <!-- Region + State + Additional affiliates -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-x-10 gap-y-8 mb-14">
        <div class="border-t border-gold/30 pt-5">
          <span class="text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-gold">Region</span>
          <h3 class="font-heading text-xl font-semibold text-text mt-2 leading-snug">{affiliations.region.name}</h3>
          <p class="text-[0.95rem] text-text/70 mt-1">{affiliations.region.abbreviation}</p>
        </div>

        <div class="border-t border-gold/30 pt-5">
          <span class="text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-gold">State</span>
          <h3 class="font-heading text-xl font-semibold text-text mt-2 leading-snug">{affiliations.state.name}</h3>
          <p class="text-[0.95rem] text-text/70 mt-1">{affiliations.state.abbreviation}</p>
        </div>

        {affiliations.other.length > 0 && (
          <div class="border-t border-gold/30 pt-5">
            <span class="text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-gold">Additional Affiliates</span>
            <ul class="mt-2 space-y-1.5">
              {affiliations.other.map((org) => (
                <li class="font-heading text-xl font-semibold text-text leading-snug">{org.name}</li>
              ))}
            </ul>
          </div>
        )}
      </div>

      <!-- NGC Support narratives -->
      {affiliations.howWeSupport.length > 0 && (
        <div class="border-t border-gold/30 pt-7">
          <h3 class="text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-gold mb-6">
            How We Support NGC
          </h3>
          <ul class="space-y-4 max-w-3xl">
            {affiliations.howWeSupport.map((item) => (
              <li class="flex items-start gap-4 text-text/80 leading-relaxed">
                <span class="mt-[0.65rem] w-1 h-1 rounded-full bg-gold flex-shrink-0" aria-hidden="true"></span>
                {item}
              </li>
            ))}
          </ul>
        </div>
      )}

    </section>

  </div>
</BaseLayout>
