---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import OfficerCard from '../components/OfficerCard.astro';
import OptImage from '../components/OptImage.astro';
import Icon from '../components/Icon.astro';
import { clubInfo, officers, affiliations } from '../data/index';

const sortedOfficers = [...officers].sort((a, b) => a.sortOrder - b.sortOrder);
---

<BaseLayout
  title={`About Us | ${clubInfo.name}`}
  description={`Learn about the history, leadership, and affiliations of ${clubInfo.name}.`}
>
  <PageHero
    eyebrow="Our Story"
    title="About Us"
    image="/about-hero.jpg"
    decoration={{ icon: 'blossom', position: 'top-right', rotate: 'rotate-6' }}
  />

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-20">

    <!-- Club History -->
    <section aria-labelledby="history-heading" class="fade-in-section">
      <div class="max-w-3xl">
        <h2 id="history-heading" class="font-heading text-3xl font-bold text-text mb-6">Our History</h2>
        <div class="space-y-4 text-text/75 leading-relaxed">
          <p>
            <strong class="text-text">{clubInfo.name}</strong> was founded in
            <strong class="text-text">{clubInfo.foundingDates.club}</strong> by a small group of
            passionate gardeners who believed that community beauty begins at home.
          </p>
          <p>
            In <strong class="text-text">{clubInfo.foundingDates.federation}</strong>, the club formally
            joined a regional garden federation, connecting our members with a wider network of
            horticulturalists, conservationists, and civic volunteers.
          </p>
          <p>
            In <strong class="text-text">{clubInfo.foundingDates.incorporated}</strong>, the club was
            incorporated as a <strong class="text-text">{clubInfo.nonprofitStatus}</strong>.
          </p>
          <blockquote class="italic border-l-4 border-blossom pl-4 text-text/80 bg-blossom/8 py-2 rounded-r-lg">
            &ldquo;{clubInfo.missionStatement}&rdquo;
          </blockquote>
        </div>

        <!-- Membership stats — colorful cards -->
        <div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4">
          {[
            { label: 'Active Members',    value: clubInfo.membership.activeMembers,    bg: 'bg-blossom/15 border-blossom/30',   num: 'text-holly'    },
            { label: 'Associate Members', value: clubInfo.membership.associateMembers, bg: 'bg-lavender/15 border-lavender/30', num: 'text-primary'  },
            { label: 'Honorary Members',  value: clubInfo.membership.honoraryMembers,  bg: 'bg-sunflower/12 border-sunflower/30',num: 'text-primary' },
            { label: 'Membership Cap',    value: clubInfo.membership.maxActive,        bg: 'bg-marigold/12 border-marigold/30', num: 'text-marigold-deep' },
          ].map((stat) => (
            <div class={`rounded-xl border shadow-sm p-4 text-center ${stat.bg}`}>
              <p class={`font-heading text-3xl font-bold ${stat.num}`}>{stat.value}</p>
              <p class="text-xs text-text/65 mt-1 leading-snug">{stat.label}</p>
            </div>
          ))}
        </div>
        <p class="text-xs text-text/65 mt-3 leading-relaxed italic">
          {clubInfo.membership.associateAndHonoraryNote}
        </p>
      </div>
    </section>

    <!-- Board of Officers -->
    <section aria-labelledby="officers-heading" class="fade-in-section">
      <div class="flex items-center gap-3 mb-8">
        <h2 id="officers-heading" class="font-heading text-3xl font-bold text-text">
          Board of Officers
        </h2>
        <Icon name="blossom" class="w-6 h-6 text-blossom-deep" />
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {sortedOfficers.map((officer) => (
          <OfficerCard officer={officer} />
        ))}
      </div>
    </section>

    <!-- Affiliations -->
    <section aria-labelledby="affiliations-heading" class="fade-in-section">
      <h2 id="affiliations-heading" class="font-heading text-3xl font-bold text-text mb-8">
        Our Affiliations
      </h2>

      <!-- NGC — full detail card -->
      <div class="bg-white rounded-xl border border-hen/40 shadow-sm p-6 mb-6">
        <div class="flex items-start justify-between mb-4">
          <div>
            <span class="text-xs font-semibold uppercase tracking-widest text-primary">National</span>
            <h3 class="font-heading text-xl font-semibold text-text mt-1">{affiliations.ngc.name}</h3>
          </div>
          <OptImage path="/ngc-logo.png" alt="National Garden Clubs, Inc. logo" class="w-16 h-auto object-contain flex-shrink-0" />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-3 text-sm mb-4">
          <dl class="space-y-2">
            <div>
              <dt class="text-xs font-semibold uppercase tracking-wide text-text/65">President</dt>
              <dd class="text-text/75">{affiliations.ngc.president}</dd>
            </div>
            <div>
              <dt class="text-xs font-semibold uppercase tracking-wide text-text/65">Email</dt>
              <dd>
                <a href={`mailto:${affiliations.ngc.presidentEmail}`}
                  class="text-primary hover:underline">{affiliations.ngc.presidentEmail}</a>
              </dd>
            </div>
            <div>
              <dt class="text-xs font-semibold uppercase tracking-wide text-text/65">Theme</dt>
              <dd class="italic text-text/70">&ldquo;{affiliations.ngc.theme}&rdquo;</dd>
            </div>
          </dl>
          <dl class="space-y-2">
            <div>
              <dt class="text-xs font-semibold uppercase tracking-wide text-text/65">Address</dt>
              <dd class="text-text/75">{affiliations.ngc.address}</dd>
            </div>
            <div>
              <dt class="text-xs font-semibold uppercase tracking-wide text-text/65">Phone</dt>
              <dd class="text-text/75">{affiliations.ngc.phone}</dd>
            </div>
            <div>
              <dt class="text-xs font-semibold uppercase tracking-wide text-text/65">Website</dt>
              <dd>
                <a href={`https://${affiliations.ngc.website}`} target="_blank" rel="noopener noreferrer"
                  class="text-primary hover:underline">{affiliations.ngc.website}</a>
              </dd>
            </div>
          </dl>
        </div>

        <!-- Annual Convention -->
        <div class="border-t border-blossom/20 pt-4 bg-blossom/5 -mx-6 px-6 -mb-6 pb-6 rounded-b-xl">
          <p class="text-xs font-semibold uppercase tracking-wide text-holly mb-1">Annual Convention</p>
          <p class="text-sm text-text/75">
            <strong>{affiliations.ngc.annualConvention.dates}</strong> &mdash; {affiliations.ngc.annualConvention.location}
          </p>
        </div>
      </div>

      <!-- Region + State side by side -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
        <div class="bg-white rounded-xl border border-blossom/30 shadow-sm p-6">
          <span class="text-xs font-semibold uppercase tracking-widest text-holly">Region</span>
          <h3 class="font-heading text-lg font-semibold text-text mt-1">{affiliations.region.name}</h3>
          <p class="text-sm text-text/65 mt-1">{affiliations.region.abbreviation}</p>
        </div>

        <div class="bg-white rounded-xl border border-accent/30 shadow-sm p-6">
          <span class="text-xs font-semibold uppercase tracking-widest text-primary">State</span>
          <h3 class="font-heading text-lg font-semibold text-text mt-1">{affiliations.state.name}</h3>
          <p class="text-sm text-text/65 mt-1">{affiliations.state.abbreviation}</p>
        </div>
      </div>

      <!-- Other affiliates -->
      {affiliations.other.length > 0 && (
        <div class="bg-white rounded-xl border border-lavender/30 shadow-sm p-6 mb-6">
          <span class="text-xs font-semibold uppercase tracking-widest text-primary">Additional Affiliates</span>
          <ul class="mt-2 space-y-1">
            {affiliations.other.map((org) => (
              <li class="text-sm text-text/75 flex items-center gap-2">
                <span class="text-blossom-deep" aria-hidden="true">✦</span>
                {org.name}
              </li>
            ))}
          </ul>
        </div>
      )}

      <!-- NGC Support narratives -->
      {affiliations.ngcSupport.length > 0 && (
        <div class="bg-gradient-to-br from-marigold/10 via-sunflower/8 to-blossom/10 border border-marigold/25 rounded-xl p-6">
          <h3 class="text-sm font-semibold uppercase tracking-widest text-marigold-deep mb-4">
            How We Support NGC
          </h3>
          <ul class="space-y-3">
            {affiliations.ngcSupport.map((item) => (
              <li class="flex items-start gap-3 text-sm text-text/75 leading-relaxed">
                <Icon name="blossom" class="mt-0.5 w-4 h-4 text-blossom-deep flex-shrink-0" />
                {item}
              </li>
            ))}
          </ul>
        </div>
      )}

    </section>

  </div>
</BaseLayout>
