---
import BaseLayout from '../layouts/BaseLayout.astro';
import SmartImage from '../components/SmartImage.astro';
import Flourish from '../components/Flourish.astro';
import { getImage } from 'astro:assets';
import heroDesktopSrc from '../assets/heroes/home-hero.png';
import heroMobileSrc from '../assets/heroes/home-hero-mobile.webp';
import { clubInfo } from '../data/index';

// Art-directed home hero: a portrait-ish crop on phones, the wide shot on
// larger screens. Both are optimized to WebP with responsive srcsets.
const heroDesktop = await getImage({
  src: heroDesktopSrc,
  format: 'webp',
  widths: [1280, 1920, 2560],
  sizes: '100vw',
});
const heroMobile = await getImage({
  src: heroMobileSrc,
  format: 'webp',
  widths: [480, 768, 1080],
  sizes: '100vw',
});

// Editorial index of the site's main sections, shown below the community story.
// Each entry carries one accent from the logo's palette — a small return of
// the club's color and whimsy, one hue per tile.
const siteIndex = [
  {
    number: '01',
    label: 'About Us',
    href: '/about',
    line: 'Six decades of history, our board, and our national affiliations.',
    numeral: 'text-blossom-deep/70',
    hover: 'group-hover:text-blossom-deep',
  },
  {
    number: '02',
    label: 'Resources',
    href: '/resources',
    line: 'Gardening wisdom, Delaware natives, and gardens worth the drive.',
    numeral: 'text-accent/80',
    hover: 'group-hover:text-accent',
  },
  {
    number: '03',
    label: 'Member Gardens',
    href: '/members',
    line: 'A look inside the gardens our members tend at home.',
    numeral: 'text-marigold/70',
    hover: 'group-hover:text-marigold',
  },
  {
    number: '04',
    label: 'Membership',
    href: '/membership',
    line: 'Meetings, dues, and how to join — all are welcome.',
    numeral: 'text-holly/60',
    hover: 'group-hover:text-holly',
  },
];
---

<BaseLayout title={`${clubInfo.name} — Delaware Garden Club`} description={clubInfo.missionStatement}>

  <!-- Hero -->
  <section class="relative text-background overflow-hidden">
    <div class="absolute inset-0">
      <picture class="block w-full h-full">
        <source media="(max-width: 639px)" srcset={heroMobile.srcSet.attribute} sizes="100vw" />
        <source srcset={heroDesktop.srcSet.attribute} sizes="100vw" />
        <img
          src={heroDesktop.src}
          width={heroDesktopSrc.width}
          height={heroDesktopSrc.height}
          alt=""
          class="w-full h-full object-cover"
          loading="eager"
          fetchpriority="high"
        />
      </picture>
      <div class="absolute inset-0 bg-gradient-to-b from-[#16281a]/80 via-[#16281a]/75 to-[#16281a]/85" aria-hidden="true"></div>
    </div>

    <!-- Blossom-gold-sage signature line along the hero's bottom edge -->
    <div class="absolute bottom-0 inset-x-0 h-[2px] bg-gradient-to-r from-blossom/70 via-gold-soft/70 to-accent/70" aria-hidden="true"></div>

    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-44 sm:pt-52 pb-28 sm:pb-36 text-center">
      <p class="hero-rise text-gold-soft text-xs font-semibold uppercase tracking-[0.32em] mb-6">
        Est. {clubInfo.foundingDates.club} &middot; Greenville, Delaware
      </p>
      <h1 class="hero-rise hero-rise-2 mb-5">
        <span class="block font-heading text-5xl sm:text-7xl lg:text-[7.5rem] font-semibold leading-[0.98] tracking-[-0.01em]">Garden Gate</span>
        <span class="mt-5 block text-background/90 text-sm sm:text-base font-semibold uppercase tracking-[0.5em] sm:tracking-[0.6em] pl-[0.5em]">Garden Club</span>
      </h1>
      <Flourish tone="dark" class="hero-rise hero-rise-3 mb-7" />
      <p class="hero-rise hero-rise-3 text-background/85 text-lg sm:text-xl leading-relaxed max-w-2xl mx-auto mb-11">
        {clubInfo.missionStatement}
      </p>
      <div class="hero-rise hero-rise-4 flex flex-wrap gap-4 justify-center">
        <a
          href="/membership"
          class="bg-background text-primary text-[0.8rem] font-semibold uppercase tracking-[0.18em] px-9 py-4 rounded-sm hover:bg-white transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-background focus:ring-offset-2 focus:ring-offset-primary"
        >
          Become a Member
        </a>
        <a
          href="/about"
          class="border border-background/60 text-background text-[0.8rem] font-semibold uppercase tracking-[0.18em] px-9 py-4 rounded-sm hover:bg-background/10 hover:border-background transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-background focus:ring-offset-2 focus:ring-offset-primary"
        >
          Our Story
        </a>
      </div>
    </div>
  </section>

  <!-- Annual theme — editorial pull-quote -->
  <section class="border-b border-gold/20 fade-in-section overflow-hidden">
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 pb-20 sm:pt-28 sm:pb-24 text-center">
      <!-- Hanging quotation mark, set enormous behind the quote -->
      <span
        class="absolute top-2 sm:top-0 left-1/2 -translate-x-1/2 font-heading text-[11rem] sm:text-[15rem] leading-none text-blossom/25 select-none pointer-events-none"
        aria-hidden="true"
      >&ldquo;</span>
      <p class="relative text-gold text-xs font-semibold uppercase tracking-[0.28em] mb-8">Our Theme &middot; {clubInfo.themePeriod}</p>
      <blockquote class="relative font-heading italic text-4xl sm:text-5xl lg:text-[3.4rem] text-text leading-[1.15]">
        {clubInfo.theme}
      </blockquote>
      <Flourish class="relative mt-10" />
    </div>
  </section>

  <!-- Community Service story -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-24 fade-in-section">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-14 items-center">
      <div>
        <p class="text-gold text-xs font-semibold uppercase tracking-[0.28em] mb-4">In Our Community</p>
        <h2 class="font-heading text-4xl sm:text-5xl lg:text-6xl font-semibold text-text mb-6 leading-[1.05] tracking-[-0.01em]">
          Cultivating <em class="italic text-primary">Beauty</em><br />Where We Live
        </h2>
        <p class="text-text/75 text-lg leading-relaxed mb-9">
          From pollinator gardens in local parks to festive window boxes on Main Street, our members
          volunteer hundreds of hours each year to make our community greener, more welcoming, and
          more alive.
        </p>
        <a
          href="/community-service"
          class="inline-flex items-center gap-2.5 bg-primary text-background text-[0.8rem] font-semibold uppercase tracking-[0.18em] px-9 py-4 rounded-sm hover:bg-[#1f4128] transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-gold focus:ring-offset-2"
        >
          View Our Projects
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>

      <!-- Photo grid -->
      <div class="grid grid-cols-2 gap-3" aria-hidden="true">
        {['/club-2.jpg', '/club.jpg', '/flower.jpg', '/longwood.jpg'].map((imgSrc, i) => (
          <div class:list={[
            'aspect-square overflow-hidden relative group bg-primary/5 rounded-sm',
            i === 1 ? 'mt-6' : i === 2 ? '-mt-6' : '',
          ]}>
            <SmartImage src={imgSrc} alt="" widths={[300, 600]} sizes="(min-width: 1024px) 25vw, 50vw" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Editorial site index -->
  <section class="border-t border-gold/20 fade-in-section">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
      <div class="flex items-center justify-center gap-4 mb-12">
        <div class="h-px w-10 sm:w-14 bg-gold/30" aria-hidden="true"></div>
        <p class="text-gold text-xs font-semibold uppercase tracking-[0.28em]">Explore the Club</p>
        <div class="h-px w-10 sm:w-14 bg-gold/30" aria-hidden="true"></div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 divide-y sm:divide-y-0 divide-gold/15 lg:divide-x border-y border-gold/15">
        {siteIndex.map((item) => (
          <a
            href={item.href}
            class="group flex flex-col gap-3 p-8 hover:bg-white transition-colors duration-200"
          >
            <span class:list={['font-heading italic text-4xl leading-none', item.numeral]}>{item.number}</span>
            <span class="font-heading text-2xl font-semibold text-text group-hover:text-primary transition-colors duration-200">{item.label}</span>
            <span class="text-[0.95rem] text-text/65 leading-relaxed">{item.line}</span>
            <span class:list={['mt-auto pt-2 inline-flex items-center gap-2 text-[0.72rem] font-semibold uppercase tracking-[0.18em] text-primary/70 transition-colors duration-200', item.hover]}>
              Visit
              <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Get in touch — full-bleed closing band, flush against the footer -->
  <section class="fade-in-section -mb-20">
    <div class="grid grid-cols-1 md:grid-cols-2 items-stretch bg-primary text-background">
      <div class="px-6 sm:px-12 lg:pl-[max(3rem,calc((100vw-72rem)/2+1rem))] lg:pr-20 py-20 sm:py-24 flex flex-col justify-center">
        <p class="text-gold-soft text-xs font-semibold uppercase tracking-[0.28em] mb-5">Say Hello</p>
        <h2 class="font-heading text-4xl sm:text-5xl lg:text-6xl font-semibold mb-6 leading-[1.05] tracking-[-0.01em]">Get in Touch</h2>
        <p class="text-background/80 text-lg leading-relaxed mb-10 max-w-md">
          Questions about membership, our programs, or how to get involved? We'd love to hear
          from you — reach out and a club member will be in touch.
        </p>
        <a
          href="/contact"
          class="self-start inline-flex items-center gap-2.5 bg-background text-primary text-[0.8rem] font-semibold uppercase tracking-[0.18em] px-9 py-4 rounded-sm hover:bg-white transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-gold-soft focus:ring-offset-2 focus:ring-offset-primary"
        >
          Contact the Club
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>

      <div class="min-h-[22rem]">
        <SmartImage
          src="/demuseum.webp"
          alt="Bobbee Vernon Memorial Garden at the Delaware Museum of Nature & Science"
          widths={[400, 800, 1200]}
          sizes="(min-width: 768px) 50vw, 100vw"
          class="w-full h-full object-cover"
          loading="lazy"
        />
      </div>
    </div>
  </section>

</BaseLayout>
