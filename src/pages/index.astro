---
import BaseLayout from '../layouts/BaseLayout.astro';
import { clubInfo } from '../data/index';
---

<BaseLayout title={`${clubInfo.name} — Delaware Garden Club`} description={clubInfo.missionStatement}>

  <!-- Hero -->
  <section class="relative bg-primary text-background overflow-hidden">
    <div class="absolute inset-0">
      <img src="/home-hero.png" alt="" class="w-full h-full object-cover opacity-30" loading="eager" />
      <div class="absolute inset-0 bg-primary/20 mix-blend-multiply" aria-hidden="true"></div>
    </div>
    <!-- Decorative blossom petals overlay -->
    <div class="absolute top-8 right-8 text-6xl opacity-15 rotate-12 select-none pointer-events-none" aria-hidden="true">🌸</div>
    <div class="absolute bottom-12 left-6 text-5xl opacity-10 -rotate-6 select-none pointer-events-none" aria-hidden="true">🌺</div>

    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-24 sm:py-32 text-center">
      <p class="text-blossom text-sm font-semibold uppercase tracking-widest mb-4">Est. {clubInfo.foundingDates.club}</p>
      <h1 class="font-script text-5xl sm:text-6xl lg:text-7xl font-bold leading-tight mb-6">
        {clubInfo.name}
      </h1>
      <p class="text-background/80 text-lg sm:text-xl leading-relaxed max-w-2xl mx-auto mb-10">
        {clubInfo.missionStatement}
      </p>
      <div class="flex flex-wrap gap-4 justify-center">
        <a
          href="/about"
          class="bg-background text-primary font-semibold px-8 py-4 rounded-lg hover:bg-background/90 transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-background focus:ring-offset-2 focus:ring-offset-primary"
        >
          Learn About Us
        </a>
        <a
          href="/membership"
          class="bg-blossom/25 border-2 border-blossom/60 text-background font-semibold px-8 py-4 rounded-lg hover:bg-blossom/40 hover:border-blossom transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-blossom focus:ring-offset-2 focus:ring-offset-primary"
        >
          Join the Club
        </a>
      </div>
    </div>
  </section>

  <!-- Annual Theme Banner -->
  <section class="bg-gradient-to-r from-blossom/20 via-holly-light to-blossom/15 border-y border-blossom/30 fade-in-section">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 text-center">
      <p class="text-xs font-semibold uppercase tracking-widest text-holly mb-1">Club Theme</p>
      <p class="text-xs text-text/50 mb-4">{clubInfo.themePeriod}</p>
      <blockquote class="font-heading italic text-2xl sm:text-3xl text-text leading-snug">
        &ldquo;{clubInfo.theme}&rdquo;
      </blockquote>
    </div>
  </section>

  <!-- Community Service Teaser -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20 fade-in-section">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-holly mb-3">In Our Community</p>
        <h2 class="font-heading text-3xl sm:text-4xl font-bold text-text mb-5 leading-tight">
          Cultivating Beauty<br />Where We Live
        </h2>
        <p class="text-text/70 leading-relaxed mb-8">
          From pollinator gardens in local parks to festive window boxes on Main Street, our members
          volunteer hundreds of hours each year to make our community greener, more welcoming, and
          more alive. Explore our current and past projects.
        </p>
        <a
          href="/community-service"
          class="inline-flex items-center gap-2 bg-primary text-background font-semibold px-8 py-4 rounded-lg hover:bg-primary/90 transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2"
        >
          View Our Projects
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>

      <!-- Decorative image grid -->
      <div class="grid grid-cols-2 gap-4" aria-hidden="true">
        {['/club-2.jpg', '/club.jpg', '/flower.jpg', '/longwood.jpg'].map((imgSrc, i) => (
          <div class:list={[
            'aspect-square rounded-2xl overflow-hidden shadow-sm relative group',
            i === 0 ? 'bg-blossom/20' : i === 1 ? 'bg-holly-light' : i === 2 ? 'bg-sunflower/15' : 'bg-lavender/20',
          ]}>
            <img src={imgSrc} alt="" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Colorful quick-links bar -->
  <section class="border-t border-blossom/20 bg-gradient-to-b from-background to-blossom/8 fade-in-section">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">
      <!-- Quick links grid -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-center">
        {[
          { label: 'About Us',   href: '/about',      icon: '🌿', bg: 'hover:bg-accent/15',     border: 'border-accent/25'    },
          { label: 'Resources',  href: '/resources',  icon: '🌼', bg: 'hover:bg-sunflower/15',  border: 'border-sunflower/30' },
          { label: 'Members',    href: '/members',    icon: '🌷', bg: 'hover:bg-blossom/20',    border: 'border-blossom/25'   },
          { label: 'Membership', href: '/membership', icon: '🌸', bg: 'hover:bg-holly-light',   border: 'border-holly/20'     },
        ].map((item) => (
          <a
            href={item.href}
            class={`group flex flex-col items-center gap-2 p-4 rounded-xl border ${item.border} ${item.bg} transition-colors duration-200`}
          >
            <span class="text-3xl">{item.icon}</span>
            <span class="text-sm font-medium text-primary group-hover:underline">{item.label}</span>
          </a>
        ))}
      </div>

      <!-- Big "Get in Touch" box with DEMuseum image alongside -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-stretch">
        <a
          href="/contact"
          class="group rounded-2xl border border-holly/25 bg-gradient-to-br from-holly-light via-blossom/15 to-blossom/10 p-8 sm:p-10 flex flex-col justify-center hover:shadow-md transition-all duration-300"
        >
          <div class="flex items-center gap-3 mb-4">
            <span class="text-4xl" aria-hidden="true">🌺</span>
            <span class="text-xs font-semibold uppercase tracking-widest text-holly">Say Hello</span>
          </div>
          <h2 class="font-heading text-3xl sm:text-4xl font-bold text-text mb-3">Get in Touch</h2>
          <p class="text-text/70 leading-relaxed mb-6 max-w-md">
            Questions about membership, our programs, or how to get involved? We'd love to hear
            from you — reach out and a club member will be in touch.
          </p>
          <span class="inline-flex items-center gap-2 text-sm font-semibold text-primary group-hover:underline">
            Contact the Club
            <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </span>
        </a>

        <div class="rounded-2xl overflow-hidden border border-accent/25 shadow-sm min-h-[18rem]">
          <img
            src="/demuseum.webp"
            alt="Bobbee Vernon Memorial Garden at the Delaware Museum of Nature & Science"
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
