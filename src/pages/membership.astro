---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Flourish from '../components/Flourish.astro';
import { club, meetings, getPageCopy } from '../data/index';
import Button from '../components/Button.astro';

const copy = await getPageCopy('membership');
---

<BaseLayout
  title={`Join ${club.name} | Membership in Greenville, Delaware`}
  description={`When we meet (${meetings.schedule.replace(/\.$/, '')}), annual dues, and how to join or visit ${club.name} in Greenville, Delaware. Guests are welcome.`}
>
  <PageHero
    eyebrow="Join Us"
    title="Membership"
    subtitle={copy.heroSubtitle}
    image="/membership-hero.jpg"
    accent="marigold"
  />

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-20 space-y-20">

    <!-- Apply invitation -->
    <section aria-labelledby="apply-cta-heading" class="fade-in-section text-center border-b border-gold/20 pb-16">
      <h2 id="apply-cta-heading" class="font-heading text-3xl sm:text-4xl font-semibold text-text mb-4">
        {copy.applyHeading}
      </h2>
      <p class="text-text/70 text-lg leading-relaxed max-w-xl mx-auto mb-8">
        {copy.applyText}
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <Button href="/contact/?topic=membership" arrow>Apply to Join</Button>
        <Button href="/contact/?topic=visit" variant="outline">Visit as a Guest</Button>
      </div>
    </section>

    <!-- Meeting Schedule -->
    <section aria-labelledby="schedule-heading" class="fade-in-section">
      <SectionHeader label="When We Meet" number="01" />
      <h2 id="schedule-heading" class="font-heading text-4xl sm:text-5xl font-semibold tracking-[-0.01em] text-text mb-5">
        Meeting Schedule
      </h2>

      <p class="text-text/75 text-lg mb-6 leading-relaxed max-w-2xl">
        {meetings.schedule}
      </p>

      <!-- Where: meetings rotate among homes, so the address is shared on request -->
      <div id="where-we-meet" class="border-l-2 border-gold/50 pl-7 max-w-2xl mb-10">
        <p class="text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-gold mb-2">Where We Meet</p>
        <p class="text-text/80 leading-relaxed">
          {meetings.location}{meetings.guests && ` ${meetings.guests}`}{' '}
          <a href="/contact/?topic=visit" class="text-primary font-medium underline decoration-gold/40 underline-offset-4 hover:decoration-gold">Ask for this month&rsquo;s address</a>
        </p>
      </div>

      <table class="w-full max-w-2xl" role="table">
        <caption class="sr-only">Monthly meeting time blocks</caption>
        <thead>
          <tr class="border-b border-gold/40">
            <th scope="col" class="py-3 text-left text-[0.68rem] font-semibold uppercase tracking-[0.22em] text-gold">
              Segment
            </th>
            <th scope="col" class="py-3 text-right sm:text-left text-[0.68rem] font-semibold uppercase tracking-[0.22em] text-gold">
              Time
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-primary/10">
          {meetings.timeBlocks.map((block) => (
            <tr>
              <td class="py-4 font-medium text-text pr-6">{block.label}</td>
              <td class="py-4 text-text/70 text-right sm:text-left">{block.time}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <!-- Order of Business -->
    <section aria-labelledby="agenda-heading" class="fade-in-section">
      <SectionHeader label="How We Run" number="02" />
      <h2 id="agenda-heading" class="font-heading text-4xl sm:text-5xl font-semibold tracking-[-0.01em] text-text mb-5">
        Order of Business
      </h2>
      <p class="text-text/70 mb-10 leading-relaxed max-w-2xl">
        {copy.agendaIntro}
      </p>
      <ol class="grid grid-cols-1 sm:grid-cols-2 gap-x-16 border-t border-gold/25">
        {meetings.orderOfBusiness.map((item, index) => (
          <li class="flex items-baseline gap-5 py-4 border-b border-primary/10">
            <span class="flex-shrink-0 font-heading italic text-2xl text-gold w-8 text-right" aria-hidden="true">
              {index + 1}
            </span>
            <span class="text-text/85">{item}</span>
          </li>
        ))}
      </ol>
    </section>

    <!-- Dues -->
    <section aria-labelledby="dues-heading" class="fade-in-section">
      <SectionHeader label="What It Costs" number="03" />
      <h2 id="dues-heading" class="font-heading text-4xl sm:text-5xl font-semibold tracking-[-0.01em] text-text mb-10">
        Annual Dues
      </h2>
      <dl class="max-w-2xl border-t border-gold/25">
        <div class="flex items-baseline justify-between gap-6 py-5 border-b border-primary/10">
          <dt class="font-medium text-text/75">Active Member</dt>
          <dd class="font-heading text-3xl font-semibold text-primary">{meetings.dues.active}</dd>
        </div>
        <div class="flex items-baseline justify-between gap-6 py-5 border-b border-primary/10">
          <dt class="font-medium text-text/75">Associate Member</dt>
          <dd class="font-heading text-3xl font-semibold text-primary">{meetings.dues.associate}</dd>
        </div>
        <div class="flex items-baseline justify-between gap-6 py-5 border-b border-gold/25">
          <dt class="font-medium text-text/75">Payment Deadline</dt>
          <dd class="text-text/80 italic">{meetings.dues.deadline}</dd>
        </div>
      </dl>
    </section>

    <!-- Associate & Honorary note -->
    <section aria-labelledby="membership-note-heading">
      <div class="border-l-2 border-gold/50 pl-7 max-w-2xl">
        <h2 id="membership-note-heading" class="text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-gold mb-2.5">
          Associate &amp; Honorary Membership
        </h2>
        <p class="text-text/75 leading-relaxed italic">
          {club.membership.note}
        </p>
      </div>
    </section>

    <!-- CTA -->
    <section class="text-center border-t border-gold/25 px-6 pt-16 fade-in-section">
      <h2 class="font-heading text-4xl sm:text-5xl font-semibold tracking-[-0.01em] text-text mb-4">Ready to Join?</h2>
      <p class="text-text/70 text-lg mb-6 max-w-md mx-auto leading-relaxed">
        {copy.closingText}
      </p>
      <Flourish class="mb-8" />
      <Button href="/contact/?topic=visit">Visit a Meeting</Button>
    </section>

  </div>
</BaseLayout>
