---
import type { Officer } from '../data/schema';

interface Props {
  officer: Officer;
}

const { officer } = Astro.props;
---

<article class="bg-white rounded-xl border border-accent/20 shadow-sm p-6 flex flex-col gap-2 hover:shadow-md transition-shadow duration-200">
  <span class="text-xs font-semibold uppercase tracking-widest text-primary">{officer.role}</span>
  <h3 class="font-heading text-xl font-semibold text-text">{officer.name}</h3>
  {officer.bio && (
    <p class="text-sm text-text/70 leading-relaxed mt-1">{officer.bio}</p>
  )}
</article>
