---
import type { Officer } from '../data/schema';

interface Props {
  officer: Officer;
}

const { officer } = Astro.props;
---

<article class="bg-white rounded-sm border border-primary/10 border-t-2 border-t-gold/50 shadow-[0_1px_3px_rgba(51,50,44,0.06)] p-6 flex flex-col gap-2 hover:shadow-[0_6px_20px_rgba(51,50,44,0.1)] transition-shadow duration-200">
  <span class="text-[0.65rem] font-semibold uppercase tracking-[0.2em] text-gold">
    {officer.role}
  </span>
  <h3 class="font-heading text-[1.45rem] font-semibold text-text leading-snug">{officer.name}</h3>
  {officer.bio && (
    <p class="text-base text-text/70 leading-relaxed mt-1">{officer.bio}</p>
  )}
</article>
