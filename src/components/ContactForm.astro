---
// No server-side logic needed — this is a plain HTML form.
const inputClasses = `rounded-sm border border-primary/20 bg-white px-4 py-3.5 text-base text-text placeholder:text-text/35
  focus:outline-none focus:ring-2 focus:ring-gold focus:border-transparent transition-shadow`;
---

<form
  action="https://formspree.io/f/YOUR_FORM_ID"
  method="POST"
  class="flex flex-col gap-6"
  novalidate
>
  <!-- Formspree redirect after submission -->
  <input type="hidden" name="_next" value="/thank-you" />

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
    <!-- Name -->
    <div class="flex flex-col gap-2">
      <label for="name" class="text-[0.95rem] font-medium text-text">
        Full Name <span class="text-holly" aria-hidden="true">*</span>
      </label>
      <input
        type="text"
        id="name"
        name="name"
        required
        autocomplete="name"
        placeholder="Jane Smith"
        class={inputClasses}
      />
    </div>

    <!-- Email -->
    <div class="flex flex-col gap-2">
      <label for="email" class="text-[0.95rem] font-medium text-text">
        Email Address <span class="text-holly" aria-hidden="true">*</span>
      </label>
      <input
        type="email"
        id="email"
        name="email"
        required
        autocomplete="email"
        placeholder="jane@example.com"
        class={inputClasses}
      />
    </div>
  </div>

  <!-- Subject -->
  <div class="flex flex-col gap-2">
    <label for="subject" class="text-[0.95rem] font-medium text-text">Subject</label>
    <input
      type="text"
      id="subject"
      name="subject"
      placeholder="Membership inquiry, event question…"
      class={inputClasses}
    />
  </div>

  <!-- Message -->
  <div class="flex flex-col gap-2">
    <label for="message" class="text-[0.95rem] font-medium text-text">
      Message <span class="text-holly" aria-hidden="true">*</span>
    </label>
    <textarea
      id="message"
      name="message"
      required
      rows="6"
      placeholder="Tell us how we can help…"
      class={`${inputClasses} resize-y`}
    ></textarea>
  </div>

  <!-- Submit -->
  <div>
    <button
      type="submit"
      class="inline-flex items-center gap-2.5 bg-primary text-background text-[0.8rem] font-semibold uppercase tracking-[0.18em] px-9 py-4 rounded-sm
             hover:bg-[#1f4128] transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-gold focus:ring-offset-2"
    >
      Send Message
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M17 8l4 4m0 0l-4 4m4-4H3" />
      </svg>
    </button>
  </div>
</form>
