---
// Custom inline SVG botanical icon set for Garden Gate Garden Club.
//
// These hand-tuned, single-color glyphs replace the emoji that previously
// carried the site's visual identity. Emoji render inconsistently across
// operating systems and read as informal; these vectors are crisp at any
// size, inherit the surrounding text color via `currentColor`, and echo the
// club's five-petal blossom logo.
//
// Usage:  <Icon name="blossom" class="w-6 h-6 text-blossom-deep" />
// Decorative by default (aria-hidden). Pass a `title` to expose an accessible
// label when the icon conveys meaning on its own.
export type IconName = 'blossom' | 'leaf' | 'sprout' | 'tree' | 'butterfly' | 'sun' | 'heart' | 'medal' | 'calendar' | 'trowel';

interface Props {
  name: IconName;
  class?: string;
  title?: string;
}

const { name, class: className = 'w-6 h-6', title } = Astro.props;
const labelled = Boolean(title);
---

<svg
  viewBox="0 0 24 24"
  class={className}
  fill="currentColor"
  role={labelled ? 'img' : undefined}
  aria-label={labelled ? title : undefined}
  aria-hidden={labelled ? undefined : 'true'}
  focusable="false"
>
  {title && <title>{title}</title>}

  {name === 'blossom' && (
    <g>
      <ellipse cx="12" cy="6.2" rx="2.7" ry="4.4" />
      <ellipse cx="12" cy="6.2" rx="2.7" ry="4.4" transform="rotate(72 12 12)" />
      <ellipse cx="12" cy="6.2" rx="2.7" ry="4.4" transform="rotate(144 12 12)" />
      <ellipse cx="12" cy="6.2" rx="2.7" ry="4.4" transform="rotate(216 12 12)" />
      <ellipse cx="12" cy="6.2" rx="2.7" ry="4.4" transform="rotate(288 12 12)" />
      <circle cx="12" cy="12" r="2.6" fill="#fff" fill-opacity="0.55" />
      <circle cx="12" cy="12" r="1.5" />
    </g>
  )}

  {name === 'leaf' && (
    <path d="M6.05 8.05c-2.73 2.73-2.73 7.17 0 9.9 1.47-3.42 4.04-6.32 7.36-8.03-2.77 2.34-4.71 5.6-5.4 9.32 2.6 1.23 5.8.78 7.95-1.37C19.43 14.47 20 4 20 4S9.53 4.57 6.05 8.05z" />
  )}

  {name === 'sprout' && (
    <g>
      <path d="M11 21h2v-7h-2z" />
      <path d="M12 14C12 9.6 8.4 6 4 6c-.6 0-1 .5-.9 1.1C3.7 11 7.1 14 11.2 14H12z" />
      <path d="M12 13c0-3.3 2.7-6 6-6 .6 0 1 .4.9 1-.6 3-3.3 5.2-6.5 5.2L12 13z" />
    </g>
  )}

  {name === 'tree' && (
    <path d="M17 12h2L12 2 5 12h2l-4 6h7v4h4v-4h7z" />
  )}

  {name === 'butterfly' && (
    <g>
      <ellipse cx="12" cy="12" rx="0.8" ry="4.6" />
      <path d="M11.4 11.2C11.4 7 8.7 4 5.6 4 3.9 4 3 5.3 3 7c0 3.4 3.9 5.6 8.4 4.2z" />
      <path d="M12.6 11.2C12.6 7 15.3 4 18.4 4 20.1 4 21 5.3 21 7c0 3.4-3.9 5.6-8.4 4.2z" />
      <path d="M11.4 12.6c0-2.5-2-4.6-4.4-4.6C5.3 8 4 9.3 4 11.4c0 3 3.4 4.6 7.4 3.4z" />
      <path d="M12.6 12.6c0-2.5 2-4.6 4.4-4.6 1.7 0 3 1.3 3 3.4 0 3-3.4 4.6-7.4 3.4z" />
    </g>
  )}

  {name === 'sun' && (
    <g>
      <circle cx="12" cy="12" r="4.2" />
      <g stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
        <line x1="12" y1="2" x2="12" y2="4.6" />
        <line x1="12" y1="19.4" x2="12" y2="22" />
        <line x1="2" y1="12" x2="4.6" y2="12" />
        <line x1="19.4" y1="12" x2="22" y2="12" />
        <line x1="4.9" y1="4.9" x2="6.8" y2="6.8" />
        <line x1="17.2" y1="17.2" x2="19.1" y2="19.1" />
        <line x1="19.1" y1="4.9" x2="17.2" y2="6.8" />
        <line x1="6.8" y1="17.2" x2="4.9" y2="19.1" />
      </g>
    </g>
  )}

  {name === 'heart' && (
    <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
  )}

  {name === 'medal' && (
    <path d="M9.68 13.69L12 11.93l2.31 1.76-.88-2.85L15.75 9h-2.84L12 6.19 11.09 9H8.25l1.31 2.84-.88 2.85zM20 10c0-4.42-3.58-8-8-8s-8 3.58-8 8c0 2.03.76 3.87 2 5.28V23l6-2 6 2v-7.72c1.24-1.41 2-3.25 2-5.28zm-8-6c3.31 0 6 2.69 6 6s-2.69 6-6 6-6-2.69-6-6 2.69-6 6-6z" />
  )}

  {name === 'calendar' && (
    <path d="M19 4h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V9h14v11zM7 11h5v5H7z" />
  )}

  {name === 'trowel' && (
    <path d="M14.3 2.3a2 2 0 0 0-2.83 0L8.6 5.17a2 2 0 0 0 0 2.83l1.06 1.06-6.01 6.01a2 2 0 0 0 0 2.83l2.45 2.45a2 2 0 0 0 2.83 0l6.01-6.01 1.06 1.06a2 2 0 0 0 2.83 0l2.87-2.87a2 2 0 0 0 0-2.83L14.3 2.3z" />
  )}
</svg>
