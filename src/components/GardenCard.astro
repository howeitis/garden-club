---
// Wide horizontal garden card used on /resources/gardens for both Local and
// Regional sections. Image on the left, description + outbound link on the right.
import SmartImage from './SmartImage.astro';

interface Props {
  name: string;
  location: string;
  description: string;
  /** Domain only, no protocol (e.g. "longwoodgardens.org") */
  website: string;
  image: string;
}

const { name, location, description, website, image } = Astro.props;
---

<div class="bg-white rounded-sm border border-primary/10 shadow-[0_1px_3px_rgba(51,50,44,0.06)] overflow-hidden hover:shadow-[0_6px_20px_rgba(51,50,44,0.1)] transition-shadow duration-200">
  <div class="flex flex-col md:flex-row">
    <div class="md:w-80 lg:w-96 flex-shrink-0">
      <SmartImage
        src={image}
        alt={name}
        widths={[320, 640, 960]}
        sizes="(min-width: 768px) 384px, 100vw"
        class="w-full h-60 md:h-full object-cover"
        loading="lazy"
      />
    </div>
    <div class="p-6 sm:p-8 flex-1">
      <p class="text-[0.65rem] font-semibold uppercase tracking-[0.22em] text-gold mb-2">{location}</p>
      <h3 class="font-heading text-2xl sm:text-[1.75rem] font-semibold text-text mb-3 leading-snug">{name}</h3>
      <p class="text-base text-text/75 leading-relaxed mb-5">{description}</p>
      <a
        href={`https://${website}`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-[0.95rem] font-medium text-primary underline decoration-gold/50 underline-offset-4 hover:decoration-gold"
      >
        {website}
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
        </svg>
      </a>
    </div>
  </div>
</div>
