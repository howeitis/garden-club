---
// Open gallery-style plant entry used on /resources/plants for both native
// and banned species — a photograph with text set directly on the page,
// no card chrome.
//
// `variant` switches the badge:
//   • "native" — bloom-period badge in sage
//   • "banned" — "Invasive" badge in holly
import SmartImage from './SmartImage.astro';

type Variant = 'native' | 'banned';

interface Props {
  name: string;
  scientific: string;
  description: string;
  image: string;
  /** Bloom period (e.g. "May – June"). Required for native plants only. */
  bloom?: string;
  variant: Variant;
}

const { name, scientific, description, image, bloom, variant } = Astro.props;

const BADGES: Record<Variant, string> = {
  native: 'text-primary border-accent/50',
  banned: 'text-holly border-holly/40',
};

const badgeText = variant === 'native' ? bloom : 'Invasive';
---

<div>
  <div class="overflow-hidden rounded-sm mb-6">
    <SmartImage
      src={image}
      alt={name}
      widths={[400, 800, 1200]}
      sizes="(min-width: 640px) 50vw, 100vw"
      class="w-full h-72 sm:h-80 object-cover"
      loading="lazy"
    />
  </div>
  <div class="flex items-baseline justify-between gap-3 mb-1">
    <h3 class="font-heading text-2xl font-semibold text-text">{name}</h3>
    {badgeText && (
      <span class={`text-[0.62rem] font-semibold uppercase tracking-[0.14em] px-2.5 py-1 rounded-sm border whitespace-nowrap ${BADGES[variant]}`}>
        {badgeText}
      </span>
    )}
  </div>
  <p class="text-[0.95rem] italic font-heading text-text/55 mb-3">{scientific}</p>
  <p class="text-base text-text/75 leading-relaxed">{description}</p>
</div>
