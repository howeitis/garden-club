---
import type { Project } from '../data/schema';
import OptImage from './OptImage.astro';
import Icon from './Icon.astro';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="bg-white rounded-xl border border-blossom/25 shadow-sm overflow-hidden hover:shadow-md hover:border-blossom/45 transition-all duration-200">

  <!-- Image or fallback -->
  {project.imageReference ? (
    <div class="relative h-52 bg-blossom/10 overflow-hidden">
      <OptImage
        path={project.imageReference}
        alt={`Photo of ${project.name}`}
        class="w-full h-full object-cover"
        widths={[400, 800]}
        sizes="(min-width: 768px) 50vw, 100vw"
      />
    </div>
  ) : (
    <!-- Fallback when no imageReference provided -->
    <div class="h-52 flex items-center justify-center bg-gradient-to-br from-blossom/20 to-marigold/15" aria-hidden="true">
      <Icon name="blossom" class="w-12 h-12 text-blossom-deep/60" />
    </div>
  )}

  <div class="p-6 flex flex-col gap-3">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <h3 class="font-heading text-xl font-semibold text-text">{project.name}</h3>
      <span class="text-xs font-medium bg-blossom/20 text-holly px-3 py-1 rounded-full whitespace-nowrap border border-blossom/25">
        {project.yearsActive}
      </span>
    </div>

    <!-- Location -->
    <p class="text-sm text-text/65 flex items-center gap-1">
      <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
          d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
      </svg>
      {project.location}
    </p>

    <!-- Chairperson -->
    <p class="text-sm text-text/65 flex items-center gap-1.5">
      <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
          d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
      </svg>
      <span>Chair: <span class="font-medium text-text/70">{project.chairperson}</span></span>
    </p>

    <p class="text-base text-text/70 leading-relaxed">{project.description}</p>
  </div>
</article>
