---
// Editorial project row used on /community-service. A large photograph on one
// side, text on the other; `flip` alternates the composition down the page.
import type { Project } from '../data/schema';
import SmartImage from './SmartImage.astro';

interface Props {
  project: Project;
  /** Mirror the layout (image on the right) */
  flip?: boolean;
}

const { project, flip = false } = Astro.props;
---

<article class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-14 items-center py-14 first:pt-0 last:pb-0">

  <div class:list={['md:col-span-5 overflow-hidden rounded-sm', flip && 'md:order-2']}>
    {project.imageReference ? (
      <SmartImage
        src={project.imageReference}
        alt={`Photo of ${project.name}`}
        widths={[400, 800]}
        sizes="(min-width: 768px) 42vw, 100vw"
        class="w-full h-64 sm:h-80 object-cover"
        loading="lazy"
      />
    ) : (
      <div class="w-full h-64 sm:h-80 flex items-center justify-center bg-primary/5" aria-hidden="true">
        <svg class="w-10 h-10 text-accent/60" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round">
          <path d="M14 24 C14 17 14 11 14 5" />
          <path d="M14 19 C10.5 18.5 8.5 16 8 12.5 C11.5 13 13.5 15.5 14 19 Z" />
          <path d="M14 12.5 C17 12 18.5 10 18.8 7 C15.8 7.5 14.3 9.5 14 12.5 Z" />
        </svg>
      </div>
    )}
  </div>

  <div class:list={['md:col-span-7', flip && 'md:order-1']}>
    <p class="text-[0.68rem] font-semibold uppercase tracking-[0.22em] text-gold mb-3">
      {project.location} &middot; {project.yearsActive}
    </p>
    <h3 class="font-heading text-3xl font-semibold text-text mb-4 leading-snug">{project.name}</h3>
    <p class="text-base sm:text-lg text-text/75 leading-relaxed mb-5">{project.description}</p>
    <p class="text-[0.95rem] text-text/55">
      Chaired by <span class="font-medium text-text/75">{project.chairperson}</span>
    </p>
  </div>
</article>
