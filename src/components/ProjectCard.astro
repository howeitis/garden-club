---
import type { Project } from '../data/schema';
import SmartImage from './SmartImage.astro';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="bg-white rounded-sm border border-primary/10 shadow-[0_1px_3px_rgba(51,50,44,0.06)] overflow-hidden hover:shadow-[0_6px_20px_rgba(51,50,44,0.1)] transition-shadow duration-200">

  <!-- Image or fallback -->
  {project.imageReference ? (
    <div class="relative h-56 bg-primary/5 overflow-hidden">
      <SmartImage
        src={project.imageReference}
        alt={`Photo of ${project.name}`}
        widths={[400, 800]}
        sizes="(min-width: 640px) 50vw, 100vw"
        class="w-full h-full object-cover"
        loading="lazy"
        onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
      />
      <!-- Fallback shown via JS if image fails to load -->
      <div
        class="absolute inset-0 hidden items-center justify-center bg-primary/5"
        aria-hidden="true"
      >
        <svg class="w-10 h-10 text-accent/60" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round">
          <path d="M14 24 C14 17 14 11 14 5" />
          <path d="M14 19 C10.5 18.5 8.5 16 8 12.5 C11.5 13 13.5 15.5 14 19 Z" />
          <path d="M14 12.5 C17 12 18.5 10 18.8 7 C15.8 7.5 14.3 9.5 14 12.5 Z" />
        </svg>
      </div>
    </div>
  ) : (
    <!-- Fallback when no imageReference provided -->
    <div class="h-56 flex items-center justify-center bg-primary/5" aria-hidden="true">
      <svg class="w-10 h-10 text-accent/60" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round">
        <path d="M14 24 C14 17 14 11 14 5" />
        <path d="M14 19 C10.5 18.5 8.5 16 8 12.5 C11.5 13 13.5 15.5 14 19 Z" />
        <path d="M14 12.5 C17 12 18.5 10 18.8 7 C15.8 7.5 14.3 9.5 14 12.5 Z" />
      </svg>
    </div>
  )}

  <div class="p-6 sm:p-7 flex flex-col gap-3">
    <div class="flex flex-wrap items-baseline justify-between gap-2">
      <h3 class="font-heading text-2xl font-semibold text-text">{project.name}</h3>
      <span class="text-[0.65rem] font-semibold uppercase tracking-[0.16em] text-gold border border-gold/30 px-2.5 py-1 rounded-sm whitespace-nowrap">
        {project.yearsActive}
      </span>
    </div>

    <!-- Location & chair -->
    <div class="flex flex-col gap-1.5 text-[0.95rem] text-text/60">
      <p class="flex items-center gap-2">
        <svg class="w-4 h-4 flex-shrink-0 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75"
            d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        {project.location}
      </p>
      <p class="flex items-center gap-2">
        <svg class="w-4 h-4 flex-shrink-0 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75"
            d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg>
        <span>Chair: <span class="font-medium text-text/75">{project.chairperson}</span></span>
      </p>
    </div>

    <p class="text-base text-text/75 leading-relaxed">{project.description}</p>
  </div>
</article>
