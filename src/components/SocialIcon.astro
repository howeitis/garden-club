---
// Brand glyph for a social platform, keyed by the platform name used in
// contact.json → socialLinks. Drawn as stroked line art to match the site's
// other icons (mail, location, external link) rather than filled brand marks.
//
// `socialLinks` is an open record, so an unrecognized platform falls back to a
// generic link glyph instead of rendering nothing.
export interface Props {
  platform: string;
  class?: string;
}

const { platform, class: className = 'w-4 h-4' } = Astro.props;
const key = platform.toLowerCase();
---

{key === 'facebook' && (
  <svg class={className} fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <rect x="3" y="3" width="18" height="18" rx="5" stroke-width="1.5" />
    <path d="M13 19v-8.5a2 2 0 0 1 2-2h1M10.5 13H16" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
)}

{key === 'instagram' && (
  <svg class={className} fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <rect x="3" y="3" width="18" height="18" rx="5" stroke-width="1.5" />
    <circle cx="12" cy="12" r="4" stroke-width="1.5" />
    <circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none" />
  </svg>
)}

{key !== 'facebook' && key !== 'instagram' && (
  <svg class={className} fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="1.75"
      d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"
    />
  </svg>
)}
