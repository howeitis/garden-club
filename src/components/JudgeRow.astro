---
import type { Judge } from '../data/schema';

interface Props {
  judge: Judge;
}

const { judge } = Astro.props;

const statusStyles = {
  active:   'text-holly border border-holly/30',
  emeritus: 'text-text/55 border border-text/20',
};
const statusLabel = {
  active:   'Active',
  emeritus: 'Emeritus',
};
---

<li class="flex flex-wrap items-center justify-between gap-3 py-4 border-b border-primary/10 last:border-b-0 hover:bg-primary/[0.03] transition-colors duration-150 -mx-6 px-6">
  <div class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-4">
    <span class="font-heading text-lg font-semibold text-text">{judge.name}</span>
    <span class="text-[0.95rem] text-text/60">{judge.certificationLevel}</span>
  </div>
  <span
    class:list={[
      'text-[0.62rem] font-semibold uppercase tracking-[0.18em] px-2.5 py-1 rounded-sm',
      statusStyles[judge.status],
    ]}
  >
    {statusLabel[judge.status]}
  </span>
</li>
