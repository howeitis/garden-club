---
// Reusable page hero used at the top of every interior page.
// A full-bleed photograph under a deep-green wash, with the title anchored
// bottom-left at display scale — an editorial composition rather than a
// centered caption. Content rises in on arrival (disabled for users who
// prefer reduced motion).
import { Image } from 'astro:assets';
import { resolveAsset, cappedWidths } from '../lib/assetImages';

// Hero source images live under src/assets/ so Astro can optimize them
// (WebP + responsive srcset). The `image` prop is still a public-style path
// string (e.g. "/about-hero.jpg") for a stable, simple API; resolveAsset maps
// it to the imported asset by filename. Anything not found (still in public/)
// falls back to a plain <img>.

/**
 * Each page tints its hero wash with the accent color used on that page,
 * blending down into the brand's deep green so titles stay legible and the
 * footer of the wash always lands on-palette.
 */
type Accent = 'green' | 'blossom' | 'sage' | 'gold' | 'holly' | 'hen' | 'lavender' | 'marigold';

const WASHES: Record<Accent, string> = {
  green:    'bg-gradient-to-b from-[#16281a]/45 via-[#16281a]/40 to-[#16281a]/90',
  blossom:  'bg-gradient-to-b from-[#57303c]/60 via-[#43262f]/50 to-[#16281a]/90',
  sage:     'bg-gradient-to-b from-[#33461f]/60 via-[#2a3a1c]/50 to-[#16281a]/90',
  gold:     'bg-gradient-to-b from-[#4e3f16]/60 via-[#3c3113]/50 to-[#16281a]/90',
  holly:    'bg-gradient-to-b from-[#54232b]/60 via-[#411c22]/50 to-[#16281a]/90',
  hen:      'bg-gradient-to-b from-[#26404f]/60 via-[#1f3340]/50 to-[#16281a]/90',
  lavender: 'bg-gradient-to-b from-[#3f3350]/60 via-[#322940]/50 to-[#16281a]/90',
  marigold: 'bg-gradient-to-b from-[#53381a]/60 via-[#402c15]/50 to-[#16281a]/90',
};

interface Props {
  /** Eyebrow text shown above the title (e.g. "For Gardeners") */
  eyebrow: string;
  /** Main page title */
  title: string;
  /** Optional one-line description below the title */
  subtitle?: string;
  /** Public path to the overlay image (defaults to /flower.jpg) */
  image?: string;
  /** Wash tint — match it to the accent color used on the page */
  accent?: Accent;
}

const { eyebrow, title, subtitle, image = '/flower.jpg', accent = 'green' } = Astro.props;
const heroImage = resolveAsset(image);
const wash = WASHES[accent];
---

<section class="relative text-background overflow-hidden">
  <div class="absolute inset-0">
    {heroImage ? (
      <Image
        src={heroImage}
        alt=""
        widths={cappedWidths(heroImage.width, [640, 1024, 1600, 2000])}
        sizes="100vw"
        format="webp"
        class="w-full h-full object-cover"
        loading="eager"
        fetchpriority="high"
      />
    ) : (
      <img
        src={image}
        alt=""
        class="w-full h-full object-cover"
        loading="eager"
      />
    )}
    <!-- Accent-tinted wash, weighted toward the bottom where the title sits -->
    <div class:list={['absolute inset-0', wash]} aria-hidden="true"></div>
  </div>

  <!-- Blossom-gold-sage signature line along the hero's bottom edge -->
  <div class="absolute bottom-0 inset-x-0 h-[2px] bg-gradient-to-r from-blossom/70 via-gold-soft/70 to-accent/70" aria-hidden="true"></div>

  <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-48 sm:pt-60 pb-14 sm:pb-16 md:pb-20">
    <p class="hero-rise flex items-center gap-4 text-gold-soft text-xs font-semibold uppercase tracking-[0.3em] mb-6">
      <span class="h-px w-10 bg-gold-soft/60" aria-hidden="true"></span>
      {eyebrow}
    </p>
    <h1
      class="hero-rise hero-rise-2 font-heading text-6xl sm:text-7xl lg:text-8xl font-semibold leading-[0.95] tracking-[-0.01em] max-w-4xl"
      set:html={title}
    />
    {subtitle && (
      <p class="hero-rise hero-rise-3 mt-7 text-background/85 text-lg sm:text-xl leading-relaxed max-w-2xl">{subtitle}</p>
    )}
  </div>
</section>
