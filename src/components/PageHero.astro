---
// Reusable page hero used at the top of every interior page.
// Renders the green hero band with overlay image, eyebrow, title, and subtitle.
//
// Optionally accepts a single decorative emoji (positioned in a corner of the
// hero) — a small flourish used by About, Community Service, Membership,
// Contact, and Awards & Judges.
import { Image } from 'astro:assets';

// Hero source images live in src/assets/heroes/ so Astro can optimize them
// (WebP + responsive srcset). The `image` prop is still a public-style path
// string (e.g. "/about-hero.jpg") for a stable, simple API; we resolve it to
// the imported asset by filename. Anything not found here (e.g. the default
// /flower.jpg, still in public/) falls back to a plain <img>.
const heroModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/heroes/*.{jpg,jpeg,png,webp}',
  { eager: true }
);
const heroes: Record<string, ImageMetadata> = {};
for (const [path, mod] of Object.entries(heroModules)) {
  heroes[path.split('/').pop()!] = mod.default;
}

type DecorPosition = 'top-left' | 'top-right' | 'bottom-left' | 'bottom-right';

interface Decoration {
  emoji: string;
  position?: DecorPosition;
  /** Optional rotation, e.g. "rotate-6" or "-rotate-12" */
  rotate?: string;
}

interface Props {
  /** Eyebrow text shown above the title (e.g. "For Gardeners") */
  eyebrow: string;
  /** Main page title */
  title: string;
  /** Optional one-line description below the title */
  subtitle?: string;
  /** Public path to the overlay image (defaults to /flower.jpg) */
  image?: string;
  /** Optional decorative emoji in a corner of the hero */
  decoration?: Decoration;
}

const { eyebrow, title, subtitle, image = '/flower.jpg', decoration } = Astro.props;
const heroImage = heroes[image.replace(/^\//, '')];

const POSITIONS: Record<DecorPosition, string> = {
  'top-left':     'top-6 left-8',
  'top-right':    'top-6 right-10',
  'bottom-left':  'bottom-6 left-8',
  'bottom-right': 'bottom-6 right-10',
};
---

<section class="relative text-background pt-36 sm:pt-44 pb-20 sm:pb-28 overflow-hidden">
  <div class="absolute inset-0">
    {heroImage ? (
      <Image
        src={heroImage}
        alt=""
        widths={[640, 1024, 1600, 2000]}
        sizes="100vw"
        format="webp"
        class="w-full h-full object-cover"
        loading="eager"
        fetchpriority="high"
      />
    ) : (
      <img
        src={image}
        alt=""
        class="w-full h-full object-cover"
        loading="eager"
      />
    )}
    <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-black/25 to-black/45" aria-hidden="true"></div>
  </div>

  {decoration && (
    <div
      class:list={[
        'absolute text-5xl opacity-15 select-none pointer-events-none',
        POSITIONS[decoration.position ?? 'top-right'],
        decoration.rotate ?? 'rotate-6',
      ]}
      aria-hidden="true"
    >
      {decoration.emoji}
    </div>
  )}

  <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <p class="text-blossom text-xs font-semibold uppercase tracking-widest mb-3">{eyebrow}</p>
    <h1 class="font-heading text-4xl sm:text-5xl font-bold leading-tight" set:html={title} />
    {subtitle && (
      <p class="mt-4 text-background/75 text-lg max-w-xl mx-auto">{subtitle}</p>
    )}
  </div>
</section>
