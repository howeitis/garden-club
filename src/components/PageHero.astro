---
// Reusable page hero used at the top of every interior page.
// A full-bleed photograph under a deep-green wash, with a letterspaced gold
// eyebrow, large serif title, optional subtitle, and the botanical flourish.
import { Image } from 'astro:assets';
import Flourish from './Flourish.astro';
import { resolveAsset, cappedWidths } from '../lib/assetImages';

// Hero source images live under src/assets/ so Astro can optimize them
// (WebP + responsive srcset). The `image` prop is still a public-style path
// string (e.g. "/about-hero.jpg") for a stable, simple API; resolveAsset maps
// it to the imported asset by filename. Anything not found (still in public/)
// falls back to a plain <img>.

interface Props {
  /** Eyebrow text shown above the title (e.g. "For Gardeners") */
  eyebrow: string;
  /** Main page title */
  title: string;
  /** Optional one-line description below the title */
  subtitle?: string;
  /** Public path to the overlay image (defaults to /flower.jpg) */
  image?: string;
}

const { eyebrow, title, subtitle, image = '/flower.jpg' } = Astro.props;
const heroImage = resolveAsset(image);
---

<section class="relative text-background pt-40 sm:pt-48 pb-20 sm:pb-28 overflow-hidden">
  <div class="absolute inset-0">
    {heroImage ? (
      <Image
        src={heroImage}
        alt=""
        widths={cappedWidths(heroImage.width, [640, 1024, 1600, 2000])}
        sizes="100vw"
        format="webp"
        class="w-full h-full object-cover"
        loading="eager"
        fetchpriority="high"
      />
    ) : (
      <img
        src={image}
        alt=""
        class="w-full h-full object-cover"
        loading="eager"
      />
    )}
    <!-- Deep green wash keeps every hero on-brand and the text legible -->
    <div class="absolute inset-0 bg-gradient-to-b from-[#16281a]/75 via-[#16281a]/50 to-[#16281a]/80" aria-hidden="true"></div>
  </div>

  <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <p class="text-gold-soft text-xs font-semibold uppercase tracking-[0.3em] mb-5">{eyebrow}</p>
    <h1 class="font-heading text-5xl sm:text-6xl font-semibold leading-[1.08]" set:html={title} />
    {subtitle && (
      <p class="mt-5 text-background/85 text-lg sm:text-xl leading-relaxed max-w-2xl mx-auto">{subtitle}</p>
    )}
    <Flourish tone="dark" class="mt-8" />
  </div>
</section>
