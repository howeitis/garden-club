---
// Letterspaced gold eyebrow with hairlines on either side — the single
// section-label style used above <h2> headings throughout the site.
//
// The old multi-tone API (`tone`) is retired: every label now renders in
// antique gold so sections read as one system.
interface Props {
  /** Short uppercase label (no emoji) */
  label: string;
  /** Center the label between full-width hairlines (default) or align left */
  align?: 'center' | 'left';
}

const { label, align = 'left' } = Astro.props;
---

{align === 'center' ? (
  <div class="flex items-center justify-center gap-4 mb-4" aria-hidden="false">
    <div class="h-px w-10 sm:w-14 bg-gold/30"></div>
    <span class="text-gold text-xs font-semibold uppercase tracking-[0.28em]">{label}</span>
    <div class="h-px w-10 sm:w-14 bg-gold/30"></div>
  </div>
) : (
  <div class="flex items-center gap-4 mb-4">
    <span class="text-gold text-xs font-semibold uppercase tracking-[0.28em]">{label}</span>
    <div class="h-px flex-1 max-w-[8rem] bg-gold/30" aria-hidden="true"></div>
  </div>
)}
