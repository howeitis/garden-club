---
// Drop-in replacement for a content <img> that serves an optimized, responsive
// WebP when the source lives in src/assets/, and falls back to a plain <img>
// for the handful of files that legitimately stay in public/ (logos, icons).
// Keeps the familiar `src="/foo.webp"` string API so data files and callers
// don't change.
//
// A path that resolves to neither location fails the build. Before this, a
// typo'd filename silently shipped as <img src="/typo.webp"> and 404'd in
// production — the fallback path is only for files that actually exist.
import { existsSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import { Image } from 'astro:assets';
import { resolveAsset, cappedWidths } from '../lib/assetImages';

interface Props {
  src: string;
  alt: string;
  /** Candidate render widths; clamped to the source's intrinsic width. */
  widths?: number[];
  /** `sizes` attribute — describes the displayed width across breakpoints. */
  sizes?: string;
  [key: string]: unknown;
}

const {
  src,
  alt,
  widths = [400, 800, 1200],
  sizes = '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw',
  ...rest
} = Astro.props;

const asset = resolveAsset(src);

if (!asset) {
  const publicPath = fileURLToPath(new URL(`../../public${src}`, import.meta.url));
  if (!existsSync(publicPath)) {
    throw new Error(
      `SmartImage: "${src}" was not found in src/assets/ or public/. ` +
      `Check the filename, or add the image to src/assets/content/.`
    );
  }
}

// Cap the fallback `src` (and width/height attributes) at the largest srcset
// candidate rather than the source's full resolution.
const imageWidths = asset ? cappedWidths(asset.width, widths) : [];
const imageMaxWidth = imageWidths[imageWidths.length - 1];
---

{asset ? (
  <Image
    src={asset}
    alt={alt}
    width={imageMaxWidth}
    widths={imageWidths}
    sizes={sizes}
    format="webp"
    {...rest}
  />
) : (
  <img src={src} alt={alt} {...rest} />
)}
