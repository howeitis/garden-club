---
import { clubInfo } from '../data/index';

const navLinks = [
  { label: 'About',             href: '/about' },
  { label: 'Community Service', href: '/community-service' },
  {
    label: 'Resources',
    href: '/resources',
    children: [
      { label: 'Gardening Tips',   href: '/resources/gardening-tips' },
      { label: 'Plants',           href: '/resources/plants' },
      { label: 'Gardens to Visit', href: '/resources/gardens' },
    ],
  },
  {
    label: 'Members',
    href: '/members',
    children: [
      { label: 'Member Gardens',   href: '/members' },
      { label: 'Awards & Judges',  href: '/members/awards-and-judges' },
    ],
  },
  { label: 'Membership',        href: '/membership' },
  { label: 'Contact',           href: '/contact' },
];

const currentPath = Astro.url.pathname;
const foundingYear = clubInfo.foundingDates.club.split(' ').pop();
---

<header
  id="site-header"
  class="bg-background/95 backdrop-blur-md text-primary shadow-[0_1px_0_rgba(143,116,51,0.35),0_4px_16px_rgba(51,50,44,0.06)] fixed top-0 inset-x-0 z-50 transition-transform duration-300"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-[5.5rem]">

      <!-- Club identity: watercolor crest + serif wordmark -->
      <a
        href="/"
        class="flex items-center gap-3.5 hover:opacity-85 transition-opacity duration-200"
        aria-label="Go to home page"
      >
        <img src="/gggc-clean.png" alt="" class="h-[4.25rem] w-auto object-contain flex-shrink-0" aria-hidden="true" loading="eager" />
        <span class="leading-none">
          <span class="block font-heading font-semibold text-primary text-[1.55rem] sm:text-[1.7rem] tracking-wide">Garden Gate</span>
          <span class="mt-1.5 block text-gold text-[0.6rem] sm:text-[0.64rem] font-semibold uppercase tracking-[0.3em] whitespace-nowrap">Garden Club<span class="hidden sm:inline"> &middot; Est. {foundingYear}</span></span>
        </span>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center gap-6" aria-label="Main navigation">
        {navLinks.map((link) => {
          const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));

          if (link.children) {
            return (
              <div class="relative group">
                <a
                  href={link.href}
                  class:list={[
                    'text-[0.78rem] font-semibold uppercase tracking-[0.16em] transition-colors duration-200 pb-1 border-b inline-flex items-center gap-1.5',
                    isActive
                      ? 'border-gold text-primary'
                      : 'border-transparent text-primary/70 hover:text-primary hover:border-gold/50',
                  ]}
                  aria-current={isActive ? 'page' : undefined}
                >
                  {link.label}
                  <svg class="w-3 h-3 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </a>
                <!-- Dropdown -->
                <div class="absolute left-0 top-full pt-3 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
                  <div class="bg-background border border-gold/30 shadow-[0_10px_30px_rgba(51,50,44,0.12)] py-2 min-w-[13rem]">
                    {link.children.map((child) => {
                      const isChildActive = currentPath === child.href;
                      return (
                        <a
                          href={child.href}
                          class:list={[
                            'block px-5 py-2.5 text-sm transition-colors duration-150',
                            isChildActive
                              ? 'text-primary font-semibold'
                              : 'text-text/75 hover:text-primary hover:bg-primary/5',
                          ]}
                          aria-current={isChildActive ? 'page' : undefined}
                        >
                          {child.label}
                        </a>
                      );
                    })}
                  </div>
                </div>
              </div>
            );
          }

          return (
            <a
              href={link.href}
              class:list={[
                'text-[0.78rem] font-semibold uppercase tracking-[0.16em] transition-colors duration-200 pb-1 border-b',
                isActive
                  ? 'border-gold text-primary'
                  : 'border-transparent text-primary/70 hover:text-primary hover:border-gold/50',
              ]}
              aria-current={isActive ? 'page' : undefined}
            >
              {link.label}
            </a>
          );
        })}
      </nav>

      <!-- Mobile Hamburger Button -->
      <button
        id="mobile-menu-button"
        type="button"
        class="lg:hidden inline-flex items-center justify-center p-2.5 text-primary hover:bg-primary/5 transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-gold"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Toggle navigation menu"
      >
        <!-- Hamburger icon -->
        <svg id="icon-open" class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <!-- Close icon -->
        <svg id="icon-close" class="w-7 h-7 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="lg:hidden hidden border-t border-gold/25 bg-background">
    <nav class="flex flex-col px-4 py-4 gap-1" aria-label="Mobile navigation">
      {navLinks.map((link) => {
        const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));

        if (link.children) {
          return (
            <div>
              <a
                href={link.href}
                class:list={[
                  'px-3 py-2.5 text-base font-medium transition-colors duration-200 block border-l-2',
                  isActive
                    ? 'border-gold text-primary font-semibold'
                    : 'border-transparent text-text/75 hover:text-primary',
                ]}
                aria-current={isActive ? 'page' : undefined}
              >
                {link.label}
              </a>
              <div class="pl-6">
                {link.children.map((child) => {
                  const isChildActive = currentPath === child.href;
                  return (
                    <a
                      href={child.href}
                      class:list={[
                        'px-3 py-2 text-[0.95rem] transition-colors duration-200 block border-l-2',
                        isChildActive
                          ? 'border-gold text-primary font-medium'
                          : 'border-transparent text-text/65 hover:text-primary',
                      ]}
                      aria-current={isChildActive ? 'page' : undefined}
                    >
                      {child.label}
                    </a>
                  );
                })}
              </div>
            </div>
          );
        }

        return (
          <a
            href={link.href}
            class:list={[
              'px-3 py-2.5 text-base font-medium transition-colors duration-200 border-l-2',
              isActive
                ? 'border-gold text-primary font-semibold'
                : 'border-transparent text-text/75 hover:text-primary',
            ]}
            aria-current={isActive ? 'page' : undefined}
          >
            {link.label}
          </a>
        );
      })}
    </nav>
  </div>
</header>

<script>
  // ─────────────────────────────────────────────────────────────────────────────
  // Header behavior: mobile menu toggle + scroll-direction reveal.
  //
  // IMPORTANT: Astro <ClientRouter /> swaps the entire DOM on each navigation
  // but inline <script> bodies only execute once. To survive swaps without
  // rebinding on every page, we use:
  //   • Event delegation on `document` for the menu button click
  //   • A single window scroll listener that re-queries the header each frame
  //   • An astro:page-load listener to reset per-page state (scroll position,
  //     header transform, hamburger open/close)
  // ─────────────────────────────────────────────────────────────────────────────

  function setMenuOpen(open: boolean) {
    const btn = document.getElementById('mobile-menu-button');
    const menu = document.getElementById('mobile-menu');
    const header = document.getElementById('site-header');
    const iconOpen = document.getElementById('icon-open');
    const iconClose = document.getElementById('icon-close');
    if (!btn || !menu) return;
    menu.classList.toggle('hidden', !open);
    btn.setAttribute('aria-expanded', String(open));
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
    // Always pin the header on screen while the menu is open so the menu
    // never gets hidden by the scroll-direction reveal logic.
    if (open) header?.classList.remove('-translate-y-full');
  }

  // Mobile menu — delegated click survives view transition DOM swaps
  document.addEventListener('click', (event) => {
    const target = event.target as Element | null;
    if (!target?.closest('#mobile-menu-button')) return;
    const menu = document.getElementById('mobile-menu');
    setMenuOpen(menu?.classList.contains('hidden') ?? false);
  });

  // Scroll-direction reveal: hide on scroll down, show on scroll up.
  // The header element is re-queried inside the rAF callback because the
  // reference would otherwise become stale after a view transition swap.
  let lastScrollY = window.scrollY;
  let ticking = false;

  function onScroll() {
    const header = document.getElementById('site-header');
    const menu = document.getElementById('mobile-menu');
    const y = window.scrollY;
    if (header) {
      // While the mobile menu is open, freeze the header in place so the
      // menu doesn't disappear off-screen when a stray scroll fires.
      const menuOpen = menu && !menu.classList.contains('hidden');
      if (menuOpen || y <= 0 || y < lastScrollY) {
        header.classList.remove('-translate-y-full');
      } else if (y > lastScrollY) {
        header.classList.add('-translate-y-full');
      }
    }
    lastScrollY = y;
    ticking = false;
  }

  window.addEventListener('scroll', () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(onScroll);
  }, { passive: true });

  // Reset header state on every page navigation so a fresh page always starts
  // with the menu closed, the header visible, and the scroll tracker zeroed.
  document.addEventListener('astro:page-load', () => {
    setMenuOpen(false);
    document.getElementById('site-header')?.classList.remove('-translate-y-full');
    lastScrollY = window.scrollY;
  });
</script>
