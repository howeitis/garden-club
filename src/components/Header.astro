---
import { clubInfo } from '../data/index';

const navLinks = [
  { label: 'About',             href: '/about' },
  { label: 'Community Service', href: '/community-service' },
  {
    label: 'Resources',
    href: '/resources',
    children: [
      { label: 'Tips & Gardens',  href: '/resources' },
      { label: 'Plants',          href: '/resources/plants' },
    ],
  },
  {
    label: 'Members',
    href: '/members',
    children: [
      { label: 'Member Gardens',   href: '/members' },
      { label: 'Awards & Judges',  href: '/members/awards-and-judges' },
    ],
  },
  { label: 'Membership',        href: '/membership' },
  { label: 'Contact',           href: '/contact' },
];

const currentPath = Astro.url.pathname;
---

<header
  id="site-header"
  class="bg-primary text-background shadow-md border-b-[3px] border-blossom/60 relative z-50 sticky top-0 transition-transform duration-300"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">

      <!-- Club Name / Logo — stacked two-line -->
      <a
        href="/"
        class="flex items-center gap-3 hover:opacity-90 transition-opacity duration-200"
        aria-label="Go to home page"
      >
        <img src="/gggc-hero.png" alt="" class="h-10 w-auto object-contain" aria-hidden="true" loading="eager" />
        <span class="font-script font-bold leading-tight">
          <span class="block text-lg sm:text-xl text-background">Garden Gate</span>
          <span class="block text-lg sm:text-xl text-background">Garden Club</span>
        </span>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center gap-5" aria-label="Main navigation">
        {navLinks.map((link) => {
          const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));

          if (link.children) {
            return (
              <div class="relative group">
                <a
                  href={link.href}
                  class:list={[
                    'text-sm font-medium tracking-wide transition-colors duration-200 pb-0.5 border-b-2 inline-flex items-center gap-1',
                    isActive
                      ? 'border-blossom text-background'
                      : 'border-transparent text-background/80 hover:text-background hover:border-blossom/50',
                  ]}
                  aria-current={isActive ? 'page' : undefined}
                >
                  {link.label}
                  <svg class="w-3.5 h-3.5 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </a>
                <!-- Dropdown -->
                <div class="absolute left-0 top-full pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
                  <div class="bg-white rounded-lg shadow-lg border border-accent/20 py-2 min-w-[13rem]">
                    {link.children.map((child) => {
                      const isChildActive = currentPath === child.href;
                      return (
                        <a
                          href={child.href}
                          class:list={[
                            'block px-4 py-2 text-sm transition-colors duration-150',
                            isChildActive
                              ? 'bg-primary/10 text-primary font-medium'
                              : 'text-text/80 hover:bg-primary/5 hover:text-primary',
                          ]}
                          aria-current={isChildActive ? 'page' : undefined}
                        >
                          {child.label}
                        </a>
                      );
                    })}
                  </div>
                </div>
              </div>
            );
          }

          return (
            <a
              href={link.href}
              class:list={[
                'text-sm font-medium tracking-wide transition-colors duration-200 pb-0.5 border-b-2',
                isActive
                  ? 'border-blossom text-background'
                  : 'border-transparent text-background/80 hover:text-background hover:border-blossom/50',
              ]}
              aria-current={isActive ? 'page' : undefined}
            >
              {link.label}
            </a>
          );
        })}
      </nav>

      <!-- Mobile Hamburger Button -->
      <button
        id="mobile-menu-button"
        type="button"
        class="lg:hidden inline-flex items-center justify-center p-2 rounded-md text-background hover:bg-white/10 transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-accent"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Toggle navigation menu"
      >
        <!-- Hamburger icon -->
        <svg id="icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <!-- Close icon -->
        <svg id="icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="lg:hidden hidden border-t border-white/20">
    <nav class="flex flex-col px-4 py-3 gap-1" aria-label="Mobile navigation">
      {navLinks.map((link) => {
        const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));

        if (link.children) {
          return (
            <div>
              <a
                href={link.href}
                class:list={[
                  'px-3 py-2 rounded-md text-base font-medium transition-colors duration-200 block',
                  isActive
                    ? 'bg-white/20 text-background'
                    : 'text-background/80 hover:bg-white/10 hover:text-background',
                ]}
                aria-current={isActive ? 'page' : undefined}
              >
                {link.label}
              </a>
              <div class="pl-4">
                {link.children.map((child) => {
                  const isChildActive = currentPath === child.href;
                  return (
                    <a
                      href={child.href}
                      class:list={[
                        'px-3 py-1.5 rounded-md text-sm transition-colors duration-200 block',
                        isChildActive
                          ? 'bg-white/15 text-background'
                          : 'text-background/65 hover:bg-white/10 hover:text-background',
                      ]}
                      aria-current={isChildActive ? 'page' : undefined}
                    >
                      {child.label}
                    </a>
                  );
                })}
              </div>
            </div>
          );
        }

        return (
          <a
            href={link.href}
            class:list={[
              'px-3 py-2 rounded-md text-base font-medium transition-colors duration-200',
              isActive
                ? 'bg-white/20 text-background'
                : 'text-background/80 hover:bg-white/10 hover:text-background',
            ]}
            aria-current={isActive ? 'page' : undefined}
          >
            {link.label}
          </a>
        );
      })}
    </nav>
  </div>
</header>

<script>
  // Mobile menu toggle
  const btn = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  btn?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(isOpen));
    iconOpen?.classList.toggle('hidden', isOpen);
    iconClose?.classList.toggle('hidden', !isOpen);
  });

  // Scroll-direction reveal: hide on scroll down, show on scroll up
  const header = document.getElementById('site-header');
  let lastScrollY = window.scrollY;
  let ticking = false;

  function onScroll() {
    const currentY = window.scrollY;
    if (header) {
      if (currentY <= 0) {
        // At top — always show
        header.classList.remove('-translate-y-full');
      } else if (currentY > lastScrollY) {
        // Scrolling down — hide
        header.classList.add('-translate-y-full');
      } else {
        // Scrolling up — show
        header.classList.remove('-translate-y-full');
      }
    }
    lastScrollY = currentY;
    ticking = false;
  }

  window.addEventListener('scroll', () => {
    if (!ticking) {
      requestAnimationFrame(onScroll);
      ticking = true;
    }
  }, { passive: true });
</script>
