---
// Magazine-style profile of one Member of the Month honoree: display
// headline, sticky portrait beside the story in chapters, then a
// "by the numbers" strip with the secondary photo. Used by the index page
// (current honoree) and by each honoree's permanent page.
//
// The story is the Markdown body of the honoree's file. Each "## Heading"
// starts a chapter; the heading becomes the small-caps chapter label and a
// CSS counter supplies the folio numeral (01, 02, …), so editors just write
// headings and paragraphs. Links written as [text](/page) work as expected.
import { render } from 'astro:content';
import { honoreePeriod, type Honoree } from '../data/index';
import SmartImage from './SmartImage.astro';
import ArrowIcon from './ArrowIcon.astro';

interface Props {
  member: Honoree;
  /** Eager-load the portrait (it's the LCP element on these pages). */
  eager?: boolean;
}

const { member, eager = true } = Astro.props;
const { name, headline, tagline, portrait, secondPhoto, stats, note } = member.data;
const period = honoreePeriod(member);
const hasStats = stats.length > 0;
const { Content } = await render(member);

// One accent per stat, rotating across siblings.
const statAccents = ['text-blossom-deep', 'text-gold', 'text-accent', 'text-holly'];
---

<!-- ── Feature ─────────────────────────────────────────────────────── -->
<article aria-labelledby="feature-heading" class="fade-in-section">

  <!-- Headline -->
  <header class="mb-12 sm:mb-16">
    <p class="flex items-center gap-4 text-gold text-xs font-semibold uppercase tracking-[0.28em] mb-6">
      <span class="h-px w-10 bg-gold/40" aria-hidden="true"></span>
      {period ? `Member of the Month · ${period}` : 'Featured Member'}
    </p>
    <h2 id="feature-heading" class="font-heading font-semibold text-text tracking-[-0.01em] leading-[0.98]">
      <span class="block text-5xl sm:text-6xl lg:text-7xl">{headline}</span>
      <span class="mt-3 block font-normal italic text-3xl sm:text-4xl lg:text-5xl text-blossom-deep">{tagline}</span>
    </h2>
  </header>

  <!-- Portrait + story -->
  <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-14 lg:gap-20 items-start">

    <!-- Lead portrait — stays in view on desktop while the story scrolls -->
    <figure class="md:col-span-5 md:sticky md:top-28">
      <div class="relative">
        <!-- Blossom corner brackets frame the honoree -->
        <span class="absolute -top-3 -left-3 w-12 h-12 border-t-2 border-l-2 border-blossom/70" aria-hidden="true"></span>
        <span class="absolute -bottom-3 -right-3 w-12 h-12 border-b-2 border-r-2 border-gold/50" aria-hidden="true"></span>
        <SmartImage
          src={portrait.image}
          alt={portrait.alt}
          widths={[480, 800, 1200]}
          sizes="(min-width: 768px) 40vw, 100vw"
          class="w-full aspect-[3/4] object-cover rounded-sm"
          style={portrait.focus ? `object-position: ${portrait.focus}` : undefined}
          loading={eager ? 'eager' : 'lazy'}
        />
      </div>
      {portrait.caption && (
        <figcaption class="mt-5 flex items-center gap-3 text-[0.68rem] font-semibold uppercase tracking-[0.22em] text-text/70">
          <span class="h-px w-6 bg-blossom/70" aria-hidden="true"></span>
          {portrait.caption}
        </figcaption>
      )}
    </figure>

    <!-- Story in chapters -->
    <div class="md:col-span-7">
      <div class="story">
        <Content />
      </div>

      {note && (
        <aside class="pt-10 mt-10 border-t border-gold/20">
          <div class="border-l-2 border-gold/50 pl-7">
            <p class="font-heading italic text-2xl text-text/85 leading-[1.35]">{note.text}</p>
            {note.link && note.linkText && (
              <a
                href={note.link}
                class="group mt-4 inline-flex items-center gap-2 text-[0.72rem] font-semibold uppercase tracking-[0.18em] text-primary/80 hover:text-primary transition-colors duration-200"
              >
                {note.linkText}
                <ArrowIcon class="w-3.5 h-3.5 transition-transform duration-200 group-hover:translate-x-1" />
              </a>
            )}
          </div>
        </aside>
      )}
    </div>
  </div>
</article>

<!-- ── By the numbers + second photo ───────────────────────────────── -->
{(hasStats || secondPhoto) && (
  <section aria-labelledby="numbers-heading" class="fade-in-section border-y border-gold/25 py-14 sm:py-16">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-14 items-center">

      {secondPhoto && (
        <figure class="md:col-span-5 md:order-2">
          <SmartImage
            src={secondPhoto.image}
            alt={secondPhoto.alt}
            widths={[480, 800, 1000]}
            sizes="(min-width: 768px) 40vw, 100vw"
            class="w-full aspect-[4/5] object-cover rounded-sm"
            style={secondPhoto.focus ? `object-position: ${secondPhoto.focus}` : undefined}
            loading="lazy"
          />
          {secondPhoto.caption && (
            <figcaption class="mt-5 flex items-center gap-3 text-[0.68rem] font-semibold uppercase tracking-[0.22em] text-text/70">
              <span class="h-px w-6 bg-accent/80" aria-hidden="true"></span>
              {secondPhoto.caption}
            </figcaption>
          )}
        </figure>
      )}

      {hasStats && (
        <div class:list={[secondPhoto ? 'md:col-span-7 md:order-1' : 'md:col-span-12']}>
          <p class="text-gold text-xs font-semibold uppercase tracking-[0.28em] mb-3">By the Numbers</p>
          <h3 id="numbers-heading" class="font-heading text-4xl sm:text-5xl font-semibold tracking-[-0.01em] text-text mb-10">
            {name.split(' ')[0]}, at a glance
          </h3>
          <dl class="divide-y divide-gold/20">
            {stats.map((stat, i) => (
              <div class="grid grid-cols-[minmax(6.5rem,auto)_1fr] sm:grid-cols-[minmax(9rem,auto)_1fr] gap-x-6 sm:gap-x-10 items-baseline py-6 first:pt-0 last:pb-0">
                <dd class:list={['font-heading italic text-6xl sm:text-7xl leading-none tracking-[-0.02em] order-first', statAccents[i % statAccents.length]]}>
                  {stat.value}
                </dd>
                <dt class="text-base sm:text-lg text-text/75 leading-snug">{stat.label}</dt>
              </div>
            ))}
          </dl>
        </div>
      )}
    </div>
  </section>
)}

<style>
  /* Chapter styling for the Markdown story — the one place the site uses a
     scoped stylesheet instead of utility classes, because the elements are
     produced by the Markdown renderer and can't carry classes. Each h2 is a
     chapter label with a counter-driven folio numeral; chapters are separated
     by gold hairlines; the first paragraph opens with a drop cap. Colors come
     from the theme tokens via theme() so they track tailwind.config.mjs. */
  .story { counter-reset: chapter; }

  .story :global(h2) {
    counter-increment: chapter;
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin: 0 0 1.25rem;
    padding-top: 2.5rem;
    border-top: 1px solid theme('colors.gold / 20%');
    font-family: theme('fontFamily.body');
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: theme('colors.gold');
  }
  .story :global(h2:first-child) { padding-top: 0; border-top: 0; }
  .story :global(h2)::before {
    content: counter(chapter, decimal-leading-zero);
    font-family: theme('fontFamily.heading');
    font-style: italic;
    font-weight: 400;
    font-size: 1.875rem;
    line-height: 1;
    letter-spacing: 0;
    text-transform: none;
    color: theme('colors.gold / 50%');
  }

  .story :global(p) {
    font-size: 1.125rem;
    line-height: 1.625;
    color: theme('colors.text / 85%');
    margin: 0 0 1.25rem;
  }
  .story :global(p:last-child) { margin-bottom: 0; }
  @media (min-width: 640px) {
    .story :global(p) { font-size: 1.25rem; }
  }

  .story :global(h2:first-child + p)::first-letter {
    float: left;
    margin: 0.35rem 0.75rem 0 0;
    font-family: theme('fontFamily.heading');
    font-size: 4.6rem;
    font-weight: 600;
    line-height: 0.8;
    color: theme('colors.primary');
  }

  .story :global(a) {
    color: theme('colors.primary');
    text-decoration: underline;
    text-decoration-color: theme('colors.gold / 50%');
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    transition: text-decoration-color 150ms;
  }
  .story :global(a:hover) { text-decoration-color: theme('colors.gold'); }

  /* Space between the last paragraph of one chapter and the next h2 */
  .story :global(p + h2) { margin-top: 2.5rem; }
</style>
