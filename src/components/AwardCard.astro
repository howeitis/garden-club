---
// Unboxed entry for an award the club *gives* (currently the CEW Training
// Award) — anchored by a gold hairline instead of a card, with judging
// criteria and recent winners set side by side where space allows. Awards
// the club has *received* render as a compact trophy list on the page itself.
import { render } from 'astro:content';
import type { Award } from '../data/index';
import Prose from './Prose.astro';

interface Props {
  award: Award;
}

const { award } = Astro.props;
const { name, placement, year, criteria, winners } = award.data;
const { Content } = await render(award);
---

<article class="border-t border-gold/30 pt-7 flex flex-col gap-5">

  <!-- Header -->
  <div>
    <h3 class="font-heading text-2xl font-semibold text-text leading-snug mb-2">{name}</h3>
    <p class="text-[0.7rem] font-semibold uppercase tracking-[0.2em] text-gold mb-3">
      {placement && <>{placement} &middot; </>}{year}
    </p>
    <Prose class="text-base text-text/75"><Content /></Prose>
  </div>

  {(criteria.length > 0 || winners.length > 0) && (
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-10 gap-y-5">
      <!-- Judging Criteria -->
      {criteria.length > 0 && (
        <div class:list={[winners.length === 0 && 'sm:col-span-2']}>
          <h4 class="text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-text/70 mb-2.5">Judging Criteria</h4>
          <ul class="flex flex-col gap-1.5">
            {criteria.map((criterion) => (
              <li class="flex items-start gap-2.5 text-base text-text/75">
                <span class="mt-[0.65rem] w-1 h-1 rounded-full bg-gold flex-shrink-0" aria-hidden="true"></span>
                {criterion}
              </li>
            ))}
          </ul>
        </div>
      )}

      <!-- Recent Winners -->
      {winners.length > 0 && (
        <div>
          <h4 class="text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-text/70 mb-2.5">Recent Winners</h4>
          <ul class="flex flex-col gap-1.5">
            {winners.map((winner) => (
              <li class="text-base text-text/80 flex items-start gap-2.5">
                <span class="mt-[0.65rem] w-1 h-1 rounded-full bg-holly flex-shrink-0" aria-hidden="true"></span>
                {winner}
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  )}
</article>
