---
import type { Award } from '../data/schema';

interface Props {
  award: Award;
}

const { award } = Astro.props;
---

<article class="bg-white rounded-xl border border-sunflower/25 shadow-sm p-6 flex flex-col gap-4 hover:shadow-md hover:border-sunflower/45 transition-all duration-200">

  <!-- Header row: icon, name, and meta badges -->
  <div class="flex items-start gap-3">
    <span class="text-2xl flex-shrink-0" aria-hidden="true">🏅</span>
    <div class="flex-1 min-w-0">
      <div class="flex flex-wrap items-center gap-2 mb-1">
        <h3 class="font-heading text-xl font-semibold text-text">{award.awardName}</h3>
        <!-- Category badge: DFGC in holly red, GGGC in blossom pink -->
        <span class:list={[
          'text-xs font-semibold uppercase tracking-wide px-2 py-0.5 rounded-full border',
          award.category === 'DFGC'
            ? 'bg-holly/12 text-holly border-holly/25'
            : 'bg-blossom/25 text-blossom-deep border-blossom/30',
        ]}>
          {award.category}
        </span>
      </div>
      <!-- Placement + Year -->
      <div class="flex flex-wrap gap-2 text-sm text-text/55 mb-2">
        {award.placement && (
          <span class="flex items-center gap-1">
            <span aria-hidden="true">🥇</span> {award.placement}
          </span>
        )}
        <span class="flex items-center gap-1">
          <span aria-hidden="true">📅</span> {award.year}
        </span>
      </div>
      <p class="text-base text-text/70 leading-relaxed">{award.description}</p>
    </div>
  </div>

  <!-- Judging Criteria -->
  {award.judgingCriteria.length > 0 && (
    <div>
      <h4 class="text-xs font-semibold uppercase tracking-widest text-primary mb-2">Judging Criteria</h4>
      <ul class="flex flex-col gap-1">
        {award.judgingCriteria.map((criterion) => (
          <li class="flex items-start gap-2 text-base text-text/70">
            <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-blossom flex-shrink-0" aria-hidden="true"></span>
            {criterion}
          </li>
        ))}
      </ul>
    </div>
  )}

  <!-- Recent Winners -->
  {award.recentWinners.length > 0 && (
    <div>
      <h4 class="text-xs font-semibold uppercase tracking-widest text-primary mb-2">Recent Winners</h4>
      <ul class="flex flex-col gap-1">
        {award.recentWinners.map((winner) => (
          <li class="text-base text-text/80 flex items-center gap-2">
            <span class="text-holly" aria-hidden="true">✦</span>
            {winner}
          </li>
        ))}
      </ul>
    </div>
  )}
</article>
