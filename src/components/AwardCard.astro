---
import type { Award } from '../data/schema';

interface Props {
  award: Award;
}

const { award } = Astro.props;
---

<article class="bg-white rounded-sm border border-primary/10 border-t-2 border-t-gold/50 shadow-[0_1px_3px_rgba(51,50,44,0.06)] p-6 sm:p-7 flex flex-col gap-5 hover:shadow-[0_6px_20px_rgba(51,50,44,0.1)] transition-shadow duration-200">

  <!-- Header row: icon, name, and meta badges -->
  <div class="flex items-start gap-4">
    <svg class="w-7 h-7 flex-shrink-0 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16.5 18.75h-9m9 0a3 3 0 013 3h-15a3 3 0 013-3m9 0v-3.375c0-.621-.503-1.125-1.125-1.125h-.871M7.5 18.75v-3.375c0-.621.504-1.125 1.125-1.125h.872m5.007 0H9.497m5.007 0a7.454 7.454 0 01-.982-3.172M9.497 14.25a7.454 7.454 0 00.981-3.172M5.25 4.236c-.982.143-1.954.317-2.916.52A6.003 6.003 0 007.73 9.728M5.25 4.236V4.5c0 2.108.966 3.99 2.48 5.228M5.25 4.236V2.721C7.456 2.41 9.71 2.25 12 2.25c2.291 0 4.545.16 6.75.47v1.516M7.73 9.728a6.726 6.726 0 002.748 1.35m8.272-6.842V4.5c0 2.108-.966 3.99-2.48 5.228m2.48-5.492a46.32 46.32 0 012.916.52 6.003 6.003 0 01-5.395 4.972m0 0a6.726 6.726 0 01-2.749 1.35m0 0a6.772 6.772 0 01-3.044 0" />
    </svg>
    <div class="flex-1 min-w-0">
      <div class="flex flex-wrap items-center gap-2.5 mb-1.5">
        <h3 class="font-heading text-2xl font-semibold text-text leading-snug">{award.awardName}</h3>
        <!-- Category badge: DFGC in holly burgundy, GGGC in deep blossom -->
        <span class:list={[
          'text-[0.62rem] font-semibold uppercase tracking-[0.16em] px-2 py-0.5 rounded-sm border',
          award.category === 'DFGC'
            ? 'text-holly border-holly/30'
            : 'text-blossom-deep border-blossom-deep/30',
        ]}>
          {award.category}
        </span>
      </div>
      <!-- Placement + Year -->
      <div class="flex flex-wrap gap-x-4 gap-y-1 text-[0.95rem] text-text/60 mb-2">
        {award.placement && (
          <span class="flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 flex-shrink-0 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.562.562 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />
            </svg>
            {award.placement}
          </span>
        )}
        <span class="flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 flex-shrink-0 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
        </svg>
          {award.year}
        </span>
      </div>
      <p class="text-base text-text/75 leading-relaxed">{award.description}</p>
    </div>
  </div>

  <!-- Judging Criteria -->
  {award.judgingCriteria.length > 0 && (
    <div>
      <h4 class="text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-gold mb-2.5">Judging Criteria</h4>
      <ul class="flex flex-col gap-1.5">
        {award.judgingCriteria.map((criterion) => (
          <li class="flex items-start gap-2.5 text-base text-text/75">
            <span class="mt-[0.65rem] w-1 h-1 rounded-full bg-gold flex-shrink-0" aria-hidden="true"></span>
            {criterion}
          </li>
        ))}
      </ul>
    </div>
  )}

  <!-- Recent Winners -->
  {award.recentWinners.length > 0 && (
    <div>
      <h4 class="text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-gold mb-2.5">Recent Winners</h4>
      <ul class="flex flex-col gap-1.5">
        {award.recentWinners.map((winner) => (
          <li class="text-base text-text/80 flex items-start gap-2.5">
            <span class="mt-[0.65rem] w-1 h-1 rounded-full bg-holly flex-shrink-0" aria-hidden="true"></span>
            {winner}
          </li>
        ))}
      </ul>
    </div>
  )}
</article>
