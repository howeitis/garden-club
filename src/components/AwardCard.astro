---
// Unboxed award entry — anchored by a gold hairline instead of a card, with
// judging criteria and recent winners set side by side where space allows.
import type { Award } from '../data/schema';

interface Props {
  award: Award;
}

const { award } = Astro.props;
---

<article class="border-t border-gold/30 pt-7 flex flex-col gap-5">

  <!-- Header: name and meta badges -->
  <div>
    <div class="flex flex-wrap items-center gap-2.5 mb-2">
      <h3 class="font-heading text-2xl font-semibold text-text leading-snug">{award.awardName}</h3>
      <!-- Category badge: DFGC in holly burgundy, GGGC in deep blossom -->
      <span class:list={[
        'text-[0.62rem] font-semibold uppercase tracking-[0.16em] px-2 py-0.5 rounded-sm border',
        award.category === 'DFGC'
          ? 'text-holly border-holly/30'
          : 'text-blossom-deep border-blossom-deep/30',
      ]}>
        {award.category}
      </span>
    </div>
    <p class="text-[0.7rem] font-semibold uppercase tracking-[0.2em] text-gold mb-3">
      {award.placement && <>{award.placement} &middot; </>}{award.year}
    </p>
    <p class="text-base text-text/75 leading-relaxed">{award.description}</p>
  </div>

  {(award.judgingCriteria.length > 0 || award.recentWinners.length > 0) && (
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-10 gap-y-5">
      <!-- Judging Criteria -->
      {award.judgingCriteria.length > 0 && (
        <div class:list={[award.recentWinners.length === 0 && 'sm:col-span-2']}>
          <h4 class="text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-text/50 mb-2.5">Judging Criteria</h4>
          <ul class="flex flex-col gap-1.5">
            {award.judgingCriteria.map((criterion) => (
              <li class="flex items-start gap-2.5 text-base text-text/75">
                <span class="mt-[0.65rem] w-1 h-1 rounded-full bg-gold flex-shrink-0" aria-hidden="true"></span>
                {criterion}
              </li>
            ))}
          </ul>
        </div>
      )}

      <!-- Recent Winners -->
      {award.recentWinners.length > 0 && (
        <div>
          <h4 class="text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-text/50 mb-2.5">Recent Winners</h4>
          <ul class="flex flex-col gap-1.5">
            {award.recentWinners.map((winner) => (
              <li class="text-base text-text/80 flex items-start gap-2.5">
                <span class="mt-[0.65rem] w-1 h-1 rounded-full bg-holly flex-shrink-0" aria-hidden="true"></span>
                {winner}
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  )}
</article>
