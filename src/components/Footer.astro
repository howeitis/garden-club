---
import { clubInfo } from '../data/index';

// Footer nav lists only the top-level pages, not every subpage. Subpages are
// reachable via the header's Resources / Members dropdowns.
const navLinks = [
  { label: 'About',             href: '/about' },
  { label: 'Community Service', href: '/community-service' },
  { label: 'Resources',         href: '/resources' },
  { label: 'Members',           href: '/members' },
  { label: 'Membership',        href: '/membership' },
  { label: 'Contact',           href: '/contact' },
];

const year = new Date().getFullYear();
---

<footer class="bg-primary text-background mt-16 border-t-[4px] border-blossom/60">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10">

      <!-- Club Identity — logo and name link to home -->
      <div class="flex md:block items-center gap-4 md:gap-0">
        <a
          href="/"
          class="block group hover:opacity-90 transition-opacity duration-200 flex-shrink-0"
          aria-label="Go to home page"
        >
          <span class="relative inline-flex items-center justify-center h-16 w-16 md:h-24 md:w-24 md:mb-4">
            <svg class="absolute inset-0 w-full h-full drop-shadow-sm" viewBox="0 0 32 32" fill="#ffffff" aria-hidden="true">
              <ellipse cx="16" cy="9" rx="5" ry="8" />
              <ellipse cx="16" cy="9" rx="5" ry="8" transform="rotate(72 16 16)" />
              <ellipse cx="16" cy="9" rx="5" ry="8" transform="rotate(144 16 16)" />
              <ellipse cx="16" cy="9" rx="5" ry="8" transform="rotate(216 16 16)" />
              <ellipse cx="16" cy="9" rx="5" ry="8" transform="rotate(288 16 16)" />
            </svg>
            <img
              src="/gggc-clean.png"
              alt=""
              class="relative h-12 w-12 md:h-16 md:w-16 object-contain"
              aria-hidden="true"
              loading="lazy"
            />
          </span>
          <h2 class="hidden md:block font-script text-2xl font-bold mb-3 group-hover:underline">{clubInfo.name}</h2>
        </a>
        <div class="flex-1 min-w-0 md:flex-none md:max-w-xs">
          <h2 class="md:hidden font-script text-xl font-bold leading-tight mb-1">{clubInfo.name}</h2>
          <p class="text-xs md:text-sm text-background/75 leading-snug md:leading-relaxed">
            {clubInfo.nonprofitStatus}
          </p>
        </div>
      </div>

      <!-- Navigation Links -->
      <div>
        <h3 class="text-xs uppercase tracking-widest font-semibold text-blossom/70 mb-4">Navigation</h3>
        <ul class="flex flex-col gap-2">
          {navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-background/80 hover:text-background transition-colors duration-200"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Theme / Tagline -->
      <div>
        <h3 class="text-xs uppercase tracking-widest font-semibold text-blossom/70 mb-4">This Year's Theme</h3>
        <p class="font-heading italic text-background/90 leading-relaxed">
          &ldquo;{clubInfo.theme}&rdquo;
        </p>
        <p class="mt-4 text-2xl tracking-widest opacity-40" aria-hidden="true">🌸 🌷 🌺</p>
      </div>

    </div>

    <!-- Bottom bar -->
    <div class="mt-10 pt-6 border-t border-blossom/20 text-center text-xs text-background/50">
      &copy; {year} {clubInfo.name}. All rights reserved.
    </div>
  </div>
</footer>
