---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { clubInfo, contact } from '../data/index';

export interface Props {
  title: string;
  description?: string;
  /** Keep this page out of search results. For utility pages (e.g. /thank-you)
   *  that exist only as a redirect target. Pair with the sitemap `filter` in
   *  astro.config.mjs — excluding a page from the sitemap does not stop it
   *  being indexed if anything links to it. */
  noindex?: boolean;
}

const {
  title,
  description = clubInfo.missionStatement,
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// og-share.png is a purpose-built 1200×630 card (≈88 KB) — well within WhatsApp's limit.
// gggc-hero.png is 2048×2048 at ~6 MB and would be silently dropped by most scrapers.
const ogImage = new URL('/og-share-v2.png', Astro.site).toString();

// Build JSON-LD Organization schema dynamically from validated data
const sameAs = contact.socialLinks ? Object.values(contact.socialLinks) : [];

// Convert "September 1963" → "1963-09" for Schema.org compliance
const foundingDateISO = (() => {
  const months: Record<string, string> = {
    January: '01', February: '02', March: '03', April: '04',
    May: '05', June: '06', July: '07', August: '08',
    September: '09', October: '10', November: '11', December: '12',
  };
  const [month, year] = clubInfo.foundingDates.club.split(' ');
  return `${year}-${months[month] ?? '01'}`;
})();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'LocalBusiness'],
  name: clubInfo.name,
  description: clubInfo.missionStatement,
  foundingDate: foundingDateISO,
  email: contact.primaryEmail,
  address: {
    '@type': 'PostalAddress',
    streetAddress: contact.mailingAddress.street,
    addressLocality: contact.mailingAddress.city,
    addressRegion: contact.mailingAddress.state,
    postalCode: contact.mailingAddress.zip,
    addressCountry: 'US',
  },
  sameAs,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#2A5434" />

    <!-- Standard SEO -->
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:site_name" content={clubInfo.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${clubInfo.name} — peach blossom garden club logo`} />

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={`${clubInfo.name} — peach blossom garden club logo`} />

    <!-- WhatsApp / iMessage read og:image above; no extra tags needed.
         The absolute URL resolves from `site` in astro.config.mjs. -->

    <!-- Robots: opt specific utility pages out of search results -->
    {noindex && <meta name="robots" content="noindex, follow" />}

    <!-- Canonical -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Icons & Manifest -->
    <!-- SVG favicon: modern browsers (Chrome, Firefox, Edge, Safari 14+) -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- PNG fallback: for platforms/browsers that don't support SVG favicons -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <!-- Apple touch icon: iOS Safari home screen -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />

    <!-- Google Fonts: Cormorant Garamond (headings/wordmark) + Inter (body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- JSON-LD Structured Data: Organization + LocalBusiness -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd, null, 2)} />

    <title>{title}</title>
    <ClientRouter />

    <style is:global>
      html { font-size: 18px; }
      body { text-rendering: optimizeLegibility; }
      h1, h2, h3 { text-wrap: balance; }

      /* Hero entrance: content rises in as the page arrives. */
      @keyframes heroRise {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
      }
      .hero-rise   { animation: heroRise 0.8s cubic-bezier(0.2, 0.6, 0.2, 1) both; }
      .hero-rise-2 { animation-delay: 0.12s; }
      .hero-rise-3 { animation-delay: 0.24s; }
      .hero-rise-4 { animation-delay: 0.36s; }

      /* Page transition animations */
      @keyframes fadeSlideIn {
        from { opacity: 0; transform: translateY(12px); }
        to { opacity: 1; transform: translateY(0); }
      }
      @keyframes fadeSlideOut {
        from { opacity: 1; transform: translateY(0); }
        to { opacity: 0; transform: translateY(-8px); }
      }
      ::view-transition-old(root) {
        animation: fadeSlideOut 0.2s ease-in forwards;
      }
      ::view-transition-new(root) {
        animation: fadeSlideIn 0.3s ease-out forwards;
      }

      /* Scroll-triggered fade-in for sections */
      .fade-in-section {
        opacity: 0;
        transform: translateY(24px);
        transition: opacity 0.6s ease-out, transform 0.6s ease-out;
      }
      .fade-in-section.is-visible {
        opacity: 1;
        transform: translateY(0);
      }

      /* Respect users who prefer reduced motion: content is always visible
         and page transitions cross-fade instantly. */
      @media (prefers-reduced-motion: reduce) {
        .fade-in-section {
          opacity: 1;
          transform: none;
          transition: none;
        }
        .hero-rise, .hero-rise-2, .hero-rise-3, .hero-rise-4 {
          animation: none;
        }
        ::view-transition-old(root),
        ::view-transition-new(root) {
          animation: none;
        }
      }

      ::selection {
        background: #d9a0ae55;
      }

      :focus-visible {
        outline: 2px solid #8f7433;
        outline-offset: 2px;
      }
    </style>
  </head>
  <body class="bg-background text-text font-body min-h-screen flex flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />

    <script>
      // ───────────────────────────────────────────────────────────────────────
      // Per-page setup: scroll to top on navigation + scroll-triggered fade-in.
      //
      // Astro <ClientRouter /> swaps the DOM but does not always restore
      // scroll position to the top of the new page. We force it here, and
      // re-initialize the IntersectionObserver against the freshly rendered
      // sections. The previous observer is GC'd along with the swapped-out DOM.
      // ───────────────────────────────────────────────────────────────────────

      let fadeInObserver: IntersectionObserver | null = null;

      function initFadeIn() {
        // Disconnect any previous observer to release references.
        fadeInObserver?.disconnect();
        fadeInObserver = new IntersectionObserver(
          (entries, obs) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                obs.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px' }
        );

        // Reveal anything already in the initial viewport immediately so the
        // page never appears blank below the hero. Only observe sections still
        // below the fold for the on-scroll fade-in animation.
        const viewportBottom = window.innerHeight;
        document.querySelectorAll('.fade-in-section').forEach((el) => {
          const rect = el.getBoundingClientRect();
          if (rect.top < viewportBottom) {
            el.classList.add('is-visible');
          } else {
            fadeInObserver!.observe(el);
          }
        });
      }

      function scrollToTop() {
        // Honor in-page hash links; otherwise reset to the top of the new page.
        if (window.location.hash) return;
        window.scrollTo({ top: 0, left: 0, behavior: 'instant' as ScrollBehavior });
      }

      // Initial load
      initFadeIn();
      // Every navigation (initial + view-transition swaps)
      document.addEventListener('astro:page-load', () => {
        scrollToTop();
        initFadeIn();
      });
    </script>
  </body>
</html>
