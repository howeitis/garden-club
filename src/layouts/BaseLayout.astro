---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { clubInfo, contact } from '../data/index';

export interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = clubInfo.missionStatement,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/gggc-hero.png', Astro.site).toString();

// Build JSON-LD Organization schema dynamically from validated data
const sameAs = contact.socialLinks ? Object.values(contact.socialLinks) : [];

// Convert "September 1963" → "1963-09" for Schema.org compliance
const foundingDateISO = (() => {
  const months: Record<string, string> = {
    January: '01', February: '02', March: '03', April: '04',
    May: '05', June: '06', July: '07', August: '08',
    September: '09', October: '10', November: '11', December: '12',
  };
  const [month, year] = clubInfo.foundingDates.club.split(' ');
  return `${year}-${months[month] ?? '01'}`;
})();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'LocalBusiness'],
  name: clubInfo.name,
  description: clubInfo.missionStatement,
  foundingDate: foundingDateISO,
  email: contact.primaryEmail,
  address: {
    '@type': 'PostalAddress',
    streetAddress: contact.mailingAddress.street,
    addressLocality: contact.mailingAddress.city,
    addressRegion: contact.mailingAddress.state,
    postalCode: contact.mailingAddress.zip,
    addressCountry: 'US',
  },
  sameAs,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#2D5F3E" />

    <!-- Standard SEO -->
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Icons & Manifest -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/gggc-hero.png" />
    <link rel="manifest" href="/manifest.json" />

    <!-- Google Fonts: Playfair Display (heading) + Inter (body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />

    <!-- JSON-LD Structured Data: Organization + LocalBusiness -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd, null, 2)} />

    <title>{title}</title>
  </head>
  <body class="bg-background text-text font-body min-h-screen flex flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
