---
import { ClientRouter } from 'astro:transitions';
// Self-hosted variable fonts (see tailwind.config.mjs → fontFamily). Bundled
// by Astro and served from /_astro with a long cache, so there is no
// render-blocking request to Google Fonts.
import '@fontsource-variable/cormorant-garamond';
import '@fontsource-variable/cormorant-garamond/wght-italic.css';
import '@fontsource-variable/inter';
import Analytics from '@vercel/analytics/astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { club, contact, affiliations, foundingDateISO } from '../data/index';

export interface Props {
  title: string;
  description?: string;
  /** Keep this page out of search results. For utility pages (e.g. /thank-you)
   *  that exist only as a redirect target. Pair with the sitemap `filter` in
   *  astro.config.mjs — excluding a page from the sitemap does not stop it
   *  being indexed if anything links to it. */
  noindex?: boolean;
  /** Override the canonical URL (site-relative path or absolute). Used when a
   *  page mirrors content whose permanent home is elsewhere — e.g. the Member
   *  of the Month index canonicalizes to the current honoree's own URL. */
  canonical?: string;
  /** Absolute URL of a page-specific share image. Defaults to the club card. */
  ogImage?: string;
  ogImageAlt?: string;
  /** Open Graph type; profiles and stories are "article". */
  ogType?: 'website' | 'article';
  /** Additional JSON-LD objects (BreadcrumbList, Person, …) emitted alongside
   *  the site-wide Organization schema. */
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description = club.mission,
  noindex = false,
  canonical,
  ogType = 'website',
  jsonLd: extraJsonLd = [],
} = Astro.props;

const canonicalURL = canonical ? new URL(canonical, Astro.site) : new URL(Astro.url.pathname, Astro.site);
// og-share-v3.png is generated by scripts/share-card/build.mjs (1200×630, ~80 KB) — well within WhatsApp's limit.
// Don't point this at a full-size photo; multi-MB images are silently dropped by most scrapers.
const defaultOgImage = new URL('/og-share-v3.png', Astro.site).toString();
const ogImage = Astro.props.ogImage ?? defaultOgImage;
const ogImageAlt = Astro.props.ogImageAlt ?? `${club.name} — peach blossom garden club logo`;
const hasCustomOgImage = ogImage !== defaultOgImage;

// Build JSON-LD Organization schema dynamically from validated data
const sameAs = Object.values(contact.social).filter((url): url is string => !!url);

// Organization rather than LocalBusiness: a nonprofit club has no opening
// hours or telephone, and Search Console flags LocalBusiness without them.
const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': new URL('/#organization', Astro.site).toString(),
  name: club.name,
  alternateName: club.shortName,
  url: Astro.site?.toString(),
  logo: new URL('/gggc-clean.png', Astro.site).toString(),
  description: club.mission,
  foundingDate: foundingDateISO,
  foundingLocation: { '@type': 'Place', name: 'Greenville, Delaware' },
  areaServed: { '@type': 'Place', name: 'Wilmington, Delaware' },
  nonprofitStatus: 'https://schema.org/Nonprofit501c3',
  email: contact.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: contact.address.street,
    addressLocality: contact.address.city,
    addressRegion: contact.address.state,
    postalCode: contact.address.zip,
    addressCountry: 'US',
  },
  memberOf: [
    { '@type': 'Organization', name: affiliations.national.name, url: `https://${affiliations.national.website}` },
    { '@type': 'Organization', name: affiliations.state.name },
    { '@type': 'Organization', name: affiliations.region.name },
  ],
  sameAs,
};

const jsonLdBlocks = [
  organizationJsonLd,
  ...extraJsonLd.map((block) => ({ '@context': 'https://schema.org', ...block })),
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#2A5434" />

    <!-- Marks the document as JS-capable before first paint. Scroll-reveal
         animations hide content until a script shows it, so they are scoped
         to `.js` — without JavaScript the page is simply fully visible. -->
    <script is:inline>document.documentElement.classList.add('js');</script>

    <!-- Standard SEO -->
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:site_name" content={club.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    {!hasCustomOgImage && (
      <>
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )}
    <meta property="og:image:alt" content={ogImageAlt} />

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- WhatsApp / iMessage read og:image above; no extra tags needed.
         The absolute URL resolves from `site` in astro.config.mjs. -->

    <!-- Robots: opt specific utility pages out of search results -->
    {noindex && <meta name="robots" content="noindex, follow" />}

    <!-- Canonical -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Icons & Manifest -->
    <!-- SVG favicon: modern browsers (Chrome, Firefox, Edge, Safari 14+) -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- PNG fallback: for platforms/browsers that don't support SVG favicons -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <!-- Apple touch icon: iOS Safari home screen -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />

    <!-- JSON-LD Structured Data: site-wide Organization + any page-specific blocks -->
    {jsonLdBlocks.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block, null, 2)} />
    ))}

    <title>{title}</title>
    <ClientRouter />
    <Analytics />

    <style is:global>
      html { font-size: 18px; }
      body { text-rendering: optimizeLegibility; }
      h1, h2, h3 { text-wrap: balance; }
      /* Fixed header is 5.5rem tall; keep in-page anchor targets clear of it. */
      [id] { scroll-margin-top: 7rem; }

      /* Hero entrance: content rises in as the page arrives. */
      @keyframes heroRise {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
      }
      .hero-rise   { animation: heroRise 0.8s cubic-bezier(0.2, 0.6, 0.2, 1) both; }
      .hero-rise-2 { animation-delay: 0.12s; }
      .hero-rise-3 { animation-delay: 0.24s; }
      .hero-rise-4 { animation-delay: 0.36s; }

      /* Page transition animations */
      @keyframes fadeSlideIn {
        from { opacity: 0; transform: translateY(12px); }
        to { opacity: 1; transform: translateY(0); }
      }
      @keyframes fadeSlideOut {
        from { opacity: 1; transform: translateY(0); }
        to { opacity: 0; transform: translateY(-8px); }
      }
      ::view-transition-old(root) {
        animation: fadeSlideOut 0.2s ease-in forwards;
      }
      ::view-transition-new(root) {
        animation: fadeSlideIn 0.3s ease-out forwards;
      }

      /* Scroll-triggered fade-in for sections. Only applies once the inline
         script in <head> has added `.js` to <html>; otherwise sections would
         stay invisible for anyone whose scripts fail or are blocked. */
      .js .fade-in-section {
        opacity: 0;
        transform: translateY(24px);
        transition: opacity 0.6s ease-out, transform 0.6s ease-out;
      }
      .js .fade-in-section.is-visible {
        opacity: 1;
        transform: translateY(0);
      }

      /* Respect users who prefer reduced motion: content is always visible
         and page transitions cross-fade instantly. */
      @media (prefers-reduced-motion: reduce) {
        .js .fade-in-section {
          opacity: 1;
          transform: none;
          transition: none;
        }
        .hero-rise, .hero-rise-2, .hero-rise-3, .hero-rise-4 {
          animation: none;
        }
        ::view-transition-old(root),
        ::view-transition-new(root) {
          animation: none;
        }
      }

      ::selection {
        background: #d9a0ae55;
      }

      :focus-visible {
        outline: 2px solid #856b2e;
        outline-offset: 2px;
      }
    </style>
  </head>
  <body class="bg-background text-text font-body min-h-screen flex flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />

    <script>
      // ───────────────────────────────────────────────────────────────────────
      // Per-page setup: scroll to top on navigation + scroll-triggered fade-in.
      //
      // Astro <ClientRouter /> swaps the DOM but does not always restore
      // scroll position to the top of the new page. We force it here, and
      // re-initialize the IntersectionObserver against the freshly rendered
      // sections. The previous observer is GC'd along with the swapped-out DOM.
      // ───────────────────────────────────────────────────────────────────────

      let fadeInObserver: IntersectionObserver | null = null;

      function initFadeIn() {
        // Disconnect any previous observer to release references.
        fadeInObserver?.disconnect();
        fadeInObserver = new IntersectionObserver(
          (entries, obs) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                obs.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px' }
        );

        // Reveal anything already in the initial viewport immediately so the
        // page never appears blank below the hero. Only observe sections still
        // below the fold for the on-scroll fade-in animation.
        const viewportBottom = window.innerHeight;
        document.querySelectorAll('.fade-in-section').forEach((el) => {
          const rect = el.getBoundingClientRect();
          if (rect.top < viewportBottom) {
            el.classList.add('is-visible');
          } else {
            fadeInObserver!.observe(el);
          }
        });
      }

      function scrollToTop() {
        // Honor in-page hash links; otherwise reset to the top of the new page.
        if (window.location.hash) return;
        window.scrollTo({ top: 0, left: 0, behavior: 'instant' as ScrollBehavior });
      }

      // Initial load
      initFadeIn();
      // Every navigation (initial + view-transition swaps)
      document.addEventListener('astro:page-load', () => {
        scrollToTop();
        initFadeIn();
      });
    </script>
  </body>
</html>
