{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "garden-club-eight.vercel.app" }],
      "destination": "https://gardengategardenclub.com/:path*",
      "permanent": true
    }
  ]
}
