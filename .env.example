# Copy this file to `.env` for local development.
# In production these are set in Vercel → Project → Settings → Environment Variables.
# `.env` is gitignored; this example file is not.

# Web3Forms access key for the contact form.
# Request one at https://web3forms.com using gardengate.communications@gmail.com —
# the key is emailed to you and submissions are delivered to that address.
# This key is public by design (it appears in the page HTML); it lives here only
# so it can be rotated without a code change.
# If unset, the contact page shows a mailto: fallback instead of the form.
PUBLIC_WEB3FORMS_KEY=

# Overrides the production domain used for canonical URLs, the sitemap, JSON-LD,
# and Open Graph image URLs. Leave unset — astro.config.mjs already defaults to
# https://gardengategardenclub.com. Only set this to build for a different host.
# SITE_URL=
